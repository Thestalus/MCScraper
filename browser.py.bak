@app.route("/similar/<story_id>")
def similar(story_id):
    s = _data.get("by_id", {}).get(story_id)
    if not s:
        abort(404)
    results = []
    cached = _recs_cache.get("similar", {}).get(story_id)
    if cached:
        by_id = _data.get("by_id", {})
        results = [(by_id[sid], score) for sid, score in cached if sid in by_id]
    elif _rec:
        if not _engine._loaded:
            _engine.build_index(_data["stories"], cache_path=Path(OUTPUT_DIR) / "recs_embeddings.npz")
        results = _rec.similar_to_story(story_id, n=24)
    # Optional word-count filter from "shorter / longer" links
    try:
        max_words = int(request.args.get("max_words", 0))
    except (ValueError, TypeError):
        max_words = 0
    try:
        min_words = int(request.args.get("min_words", 0))
    except (ValueError, TypeError):
        min_words = 0
    if max_words:
        results = [(sim, sc) for sim, sc in results if sim.get("word_count", 0) <= max_words]
    if min_words:
        results = [(sim, sc) for sim, sc in results if sim.get("word_count", 0) >= min_words]
    tmpl = app.jinja_env.from_string(SIMILAR_TMPL)
    return tmpl.render(story=s, results=results,
                       index_ready=bool(cached or _engine._loaded), request=request)


@app.route("/recommendations")
def recommendations():
    if not _rec:
        abort(503)
    profile = _rec.taste_profile_summary()
    shuffle = request.args.get("shuffle") == "1"
    hidden_count = len(_prefs.data.get("hidden_recs", [])) if _prefs else 0
    cached_pers = _recs_cache.get("personalised")
    if cached_pers:
        by_id = _data.get("by_id", {})
        hidden = set(_prefs.data.get("hidden_recs", [])) if _prefs else set()
        recs = [(by_id[sid], score, reason) for sid, score, reason in cached_pers
                if sid in by_id and sid not in hidden]
        if shuffle:
            import random
            random.shuffle(recs)
    else:
        if not _engine._loaded:
            _engine.build_index(_data["stories"], cache_path=Path(OUTPUT_DIR) / "recs_embeddings.npz")
        recs = _rec.personalised_recommendations(n=200, shuffle=shuffle)
    tmpl = app.jinja_env.from_string(RECS_TMPL)
    return tmpl.render(recs=recs, profile=profile,
                       liked_count=_prefs.total_likes if _prefs else 0,
                       index_ready=_engine._loaded,
                       semantic=_engine.semantic,
                       hidden_count=hidden_count,
                       request=request)


@app.route("/author-similar/<path:author_name>")
def author_similar(author_name):
    if not _rec:
        abort(503)
    if not _engine._loaded:
        _engine.build_index(_data["stories"], cache_path=Path(OUTPUT_DIR) / "recs_embeddings.npz")
    similar_authors = _rec.similar_authors(author_name, n=12)
    author_stories  = _data.get("by_author", {}).get(author_name, [])
    author_status   = _prefs.author_status(author_name) if _prefs else "none"
    tmpl = app.jinja_env.from_string(AUTHOR_SIMILAR_TMPL)
    return tmpl.render(
        author=author_name, similar=similar_authors,
        story_count=len(author_stories), author_status=author_status,
        index_ready=_engine._loaded, request=request
    )


