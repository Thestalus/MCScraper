@app.route("/bibles/<bible_id>/read")
def bible_read(bible_id):
    bible = load_bible(bible_id)
    if not bible:
        abort(404)
    # Serve all generated chapters as readable text
    generated = bible.get("generated", [])
    tmpl = app.jinja_env.from_string(BIBLE_READ_TMPL)
    return tmpl.render(bible=bible, generated=generated, request=request)


BIBLE_READ_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="max-width:780px;">
  <div style="display:flex; gap:1.5rem; align-items:baseline; margin-bottom:1.5rem;">
    <h1 class="page-title" style="margin:0;border:none;">{{ bible.title }}</h1>
    <a href="/bibles/{{ bible.id }}/write" style="font-size:0.88rem;">&#9998; Write chapter</a>
    <a href="/bibles/{{ bible.id }}/edit" style="font-size:0.88rem; color:var(--muted);">Edit</a>
  </div>
  {% if bible.premise %}
  <p style="font-style:italic; color:var(--muted); margin-bottom:2rem; font-size:1.05rem;">
    {{ bible.premise }}</p>
  {% endif %}
  {% for g in generated %}
  <div style="margin-bottom:3rem;">
    <h2 style="font-size:1.2rem; color:var(--accent2); margin-bottom:0.25rem; font-weight:400;">
      Chapter {{ g.chapter }}{% if g.title %} — {{ g.title }}{% endif %}
    </h2>
    <div style="font-size:1.15rem; line-height:2.0; white-space:pre-wrap;">{{ g.text }}</div>
  </div>
  {% else %}
  <p style="color:var(--muted);">No chapters generated yet.
    <a href="/bibles/{{ bible.id }}/write">Write the first chapter &rarr;</a></p>
  {% endfor %}
</div>
{% endblock %}
''')


@app.route("/api/bible/write", methods=["POST"])
def api_bible_write():
    from generator import LLMClient, estimate_tokens
    from flask import Response, stream_with_context
    data  = request.get_json(force=True)
    bible = load_bible(data.get("bible_id",""))
    if not bible:
        return jsonify({"error": "Bible not found"}), 404

    url         = data.get("url", "http://localhost:1234/v1")
    model_name  = data.get("model", "auto")
    temperature = float(data.get("temperature", 0.85))
    max_tokens  = int(data.get("max_tokens", 3000))
    instruction = data.get("instruction", "")

    messages = next_chapter_prompt(bible, instruction)
    client   = LLMClient(base_url=url, api_key="none", model=model_name)

    if not client.ping():
        return jsonify({"error": "Cannot connect to LLM"}), 503

    def gen():
        try:
            for chunk in client.complete(messages, max_tokens=max_tokens,
                                         temperature=temperature, stream=True):
                yield chunk
        except Exception as e:
            yield f"\n\n[Error: {e}]"

    return Response(stream_with_context(gen()), mimetype="text/plain",
                    headers={"X-Accel-Buffering":"no","Cache-Control":"no-cache"})


@app.route("/api/bible/summarise", methods=["POST"])
def api_bible_summarise():
    from generator import LLMClient
    data        = request.get_json(force=True)
    text        = data.get("text","")
    chapter_num = data.get("chapter_num", 1)
    url         = data.get("url", "http://localhost:1234/v1")
    messages    = auto_summarise_prompt(text, chapter_num)
    client      = LLMClient(base_url=url, api_key="none")
    try:
        summary = client.complete(messages, max_tokens=200, temperature=0.3)
        return jsonify({"summary": summary.strip()})
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/bible/save-chapter", methods=["POST"])
def api_bible_save_chapter():
    data     = request.get_json(force=True)
    bible_id = data.get("bible_id","")
    bible    = load_bible(bible_id)
    if not bible:
        return jsonify({"ok": False, "error": "Bible not found"})

    chapter_num = data.get("chapter_num", len(bible.get("chapters",[])) + 1)
    bible.setdefault("chapters", []).append({
        "number":     chapter_num,
        "title":      data.get("title",""),
        "summary":    data.get("summary",""),
        "word_count": len(data.get("text","").split()),
        "saved_at":   datetime.now().isoformat() if False else __import__("datetime").datetime.now().isoformat(),
    })
    bible.setdefault("generated", []).append({
        "chapter":      chapter_num,
        "title":        data.get("title",""),
        "text":         data.get("text",""),
        "generated_at": __import__("datetime").datetime.now().isoformat(),
    })
    save_bible(bible)
    return jsonify({"ok": True})


