  tg:"transgender",cd:"cross-dressing",sx:"sex change",bi:"bisexual",
  bd:"bondage/restraint",ds:"dominant/submissive",nc:"non-consent",
  rp:"reluctance/resistance",cb:"corruption/bimbofication",la:"lactation",
  "in":"incest",ws:"watersports",sn:"snuff",be:"breast expansion",mu:"multiple partners",
  or:"oral sex",an:"anal sex",ex:"exhibitionism",vo:"voyeurism",hu:"humiliation",
  sm:"sadomasochism",sp:"spanking",pe:"pegging",sl:"slavery/enslavement",
  si:"sissification",pt:"petplay",dg:"degradation",to:"torture",
  pr:"pregnancy/impregnation",mn:"masturbation",se:"seduction",th:"threesome",
  sw:"swapping/swinging",cr:"crushing/shrinking",gi:"giantess",ti:"tickling",
  ft:"fantasy",sf:"sci-fi",sc:"sci-fi/science",ro:"romance",gr:"growth/physical change",
  ca:"celebrity/public figure",va:"vampire",wl:"werewolf",zo:"zoophilia",
  gh:"ghost/supernatural",cy:"cyberpunk",vr:"virtual reality",tm:"time manipulation",
  uw:"underwater",ns:"non-sexual",lt:"lite/softcore",lo:"long story",ob:"obedience",
  ls:"loss of self/identity",lc:"loss of control",mr:"mind reading",gm:"gender morph",
  nd:"nudity",un:"uniform/costume",aa:"interracial",et:"ethnicity/interracial",
  ag:"age progression/regression",rs:"roleplay/scenario",nf:"non-consensual fantasy",
  hy:"hypnosis"
};
function cardWant(btn, id) {
  var active = btn.dataset.wanted === '1';
  fetch('/api/want/' + id, {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({wanted: !active})})
  .then(r => r.json()).then(d => {
    if (d.ok) {
      btn.dataset.wanted = d.wanted ? '1' : '0';
      btn.innerHTML = d.wanted ? '&#128278; Wanted' : '&#128278; Want';
      btn.style.background = d.wanted ? '#e8f4e8' : 'transparent';
      btn.style.borderColor = d.wanted ? '#4a7a4a' : 'var(--border)';
      btn.style.color = d.wanted ? '#2a5a2a' : 'var(--muted)';
    }
  });
}
document.querySelectorAll(".tag").forEach(el => {
  const code = el.textContent.trim().toLowerCase();
  if (TAG_LABELS[code]) {
    el.style.cursor = "help";
    const tip = document.createElement("span");
    tip.className = "tag-tip";
    tip.textContent = TAG_LABELS[code];
    el.appendChild(tip);
    el.title = TAG_LABELS[code];
  }
});
</script>
</body>
</html>'''

INDEX_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div class="layout">
  <aside class="sidebar">
    <form method="get" action="/search">
      {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}

      <div class="filter-section">
        <span class="filter-label">Category Tags</span>
        <input type="text" name="cat" placeholder="e.g. mc mf hm" value="{{ cat }}">
      </div>
      <div class="filter-section">
        <span class="filter-label">Exclude categories</span>
        <input type="text" name="exclude_cat" placeholder="e.g. nc sn" value="{{ exclude_cat }}">
      </div>
      <div class="filter-section">
        <span class="filter-label">MC Method</span>
        <select name="mc_type">
          <option value="">Any</option>
          {% for t in mc_types %}<option value="{{ t }}" {{ "selected" if mc_type==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Setting</span>
        <select name="setting">
          <option value="">Any</option>
          {% for t in settings %}<option value="{{ t }}" {{ "selected" if setting==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Themes <span style="font-weight:normal; text-transform:none; letter-spacing:0;">(ctrl/cmd+click)</span></span>
        <select name="theme" multiple size="6" style="height:auto;">
          {% for t in themes %}<option value="{{ t }}" {{ "selected" if t in selected_themes }}>{{ t }}</option>{% endfor %}
        </select>
        <div style="display:flex; gap:0.8rem; margin-top:0.3rem; font-size:0.78rem; color:var(--muted);">
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="theme_logic" value="any" {{ "checked" if theme_logic == "any" }} style="accent-color:var(--accent);"> any
          </label>
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="theme_logic" value="all" {{ "checked" if theme_logic != "any" }} style="accent-color:var(--accent);"> all
          </label>
        </div>
      </div>
      <div class="filter-section">
        <span class="filter-label">Tone</span>
        <select name="tone">
          <option value="">Any</option>
          {% for t in tones %}<option value="{{ t }}" {{ "selected" if tone==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Dominance style</span>
        <select name="dominance">
          <option value="">Any</option>
          {% for t in dominances %}<option value="{{ t }}" {{ "selected" if dominance==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Pacing</span>
        <select name="pacing">
          <option value="">Any</option>
          {% for t in pacings %}<option value="{{ t }}" {{ "selected" if pacing==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Victim awareness</span>
        <select name="awareness">
          <option value="">Any</option>
          {% for t in awareness_opts %}<option value="{{ t }}" {{ "selected" if awareness==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Sexual Acts <span style="font-weight:normal; text-transform:none; letter-spacing:0;">(ctrl/cmd+click)</span></span>
        <select name="sexual_act" multiple size="5" style="height:auto;">
          {% for t in sexual_acts %}<option value="{{ t }}" {{ "selected" if t in selected_sexual_acts }}>{{ t }}</option>{% endfor %}
        </select>
        <div style="display:flex; gap:0.8rem; margin-top:0.3rem; font-size:0.78rem; color:var(--muted);">
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="sexual_act_logic" value="any" {{ "checked" if sexual_act_logic != "all" }} style="accent-color:var(--accent);"> any
          </label>
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="sexual_act_logic" value="all" {{ "checked" if sexual_act_logic == "all" }} style="accent-color:var(--accent);"> all
          </label>
        </div>
      </div>
      <div class="filter-section">
        <span class="filter-label">Fetish <span style="font-weight:normal; text-transform:none; letter-spacing:0;">(ctrl/cmd+click)</span></span>
        <select name="fetish_tag" multiple size="5" style="height:auto;">
          {% for t in fetish_tags %}<option value="{{ t }}" {{ "selected" if t in selected_fetish_tags }}>{{ t }}</option>{% endfor %}
        </select>
        <div style="display:flex; gap:0.8rem; margin-top:0.3rem; font-size:0.78rem; color:var(--muted);">
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="fetish_tag_logic" value="any" {{ "checked" if fetish_tag_logic != "all" }} style="accent-color:var(--accent);"> any
          </label>
          <label style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="radio" name="fetish_tag_logic" value="all" {{ "checked" if fetish_tag_logic == "all" }} style="accent-color:var(--accent);"> all
          </label>
        </div>
      </div>
      <div class="filter-section">
        <span class="filter-label">Relationship</span>
        <select name="relationship">
          <option value="">Any</option>
          {% for t in relationships %}<option value="{{ t }}" {{ "selected" if relationship==t }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Length</span>
        <select name="length">
          <option value="">Any</option>
          {% for l in lengths %}<option value="{{ l }}" {{ "selected" if length_class==l }}>{{ l }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-section">
        <span class="filter-label">Added Date</span>
        <div style="display:flex; gap:0.4rem; align-items:center; font-size:0.82rem; color:var(--muted);">
          <span>From</span>
          <input type="month" name="date_from" value="{{ date_from }}"
                 style="flex:1; background:var(--bg3); border:1px solid var(--border);
                        color:var(--text); border-radius:3px; padding:0.2rem 0.3rem;
                        font-size:0.82rem; font-family:inherit; min-width:0;">
        </div>
        <div style="display:flex; gap:0.4rem; align-items:center; font-size:0.82rem; color:var(--muted); margin-top:0.3rem;">
          <span>To&nbsp;&nbsp;</span>
          <input type="month" name="date_to" value="{{ date_to }}"
                 style="flex:1; background:var(--bg3); border:1px solid var(--border);
                        color:var(--text); border-radius:3px; padding:0.2rem 0.3rem;
                        font-size:0.82rem; font-family:inherit; min-width:0;">
        </div>
      </div>
      <div class="filter-section">
        <span class="filter-label">Sort By</span>
        <select name="sort">
          <option value="relevance" {{ "selected" if sort=="relevance" or not sort }}>Relevance</option>
          <option value="title" {{ "selected" if sort=="title" }}>Title A–Z</option>
          <option value="author" {{ "selected" if sort=="author" }}>Author A–Z</option>
          <option value="words_desc" {{ "selected" if sort=="words_desc" }}>Longest first</option>
          <option value="words_asc" {{ "selected" if sort=="words_asc" }}>Shortest first</option>
          <option value="date" {{ "selected" if sort=="date" }}>Newest first</option>
        </select>
      </div>
      <div class="filter-section" style="border-top:1px solid var(--border); padding-top:0.6rem; margin-top:0.4rem;">
        <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; font-size:0.85rem; color:var(--muted); text-transform:none; letter-spacing:0;">
          <input type="checkbox" name="soft" value="1" {{ "checked" if soft }}
                 style="accent-color:var(--accent); width:14px; height:14px;">
          <span><strong style="color:var(--text)">Soft filters</strong> — rank by match, don't exclude</span>
        </label>
        <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; font-size:0.85rem; color:var(--muted); text-transform:none; letter-spacing:0; margin-top:0.4rem;">
          <input type="checkbox" name="archived" value="1" {{ "checked" if archived }}
                 style="accent-color:var(--accent); width:14px; height:14px;">
          <span><strong style="color:var(--text)">Archived only</strong> — Wayback Machine stories</span>
        </label>
        {% if prefs and prefs.total_likes %}
        <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; font-size:0.85rem; color:var(--muted); text-transform:none; letter-spacing:0; margin-top:0.4rem;">
          <input type="checkbox" name="liked_filter" value="1" {{ "checked" if liked_filter }}
                 style="accent-color:var(--accent); width:14px; height:14px;">
          <span><strong style="color:var(--text)">Liked only</strong> — stories &amp; liked authors</span>
        </label>
        {% endif %}
      </div>
      <div class="filter-section" style="border-top:1px solid var(--border); padding-top:0.6rem; margin-top:0.4rem;">
        <span class="filter-label">Search Mode</span>
        <div style="display:flex; gap:0.8rem; margin-top:0.3rem; font-size:0.85rem;">
          <label style="display:flex; align-items:center; gap:0.3rem; cursor:pointer; text-transform:none; letter-spacing:0; color:var(--text);">
            <input type="radio" name="search_mode" value="literal" {{ "checked" if search_mode == "literal" }}
                   style="accent-color:var(--accent);">
            Literal
          </label>
          <label style="display:flex; align-items:center; gap:0.3rem; cursor:pointer; text-transform:none; letter-spacing:0; color:var(--text);">
            <input type="radio" name="search_mode" value="fuzzy" {{ "checked" if search_mode == "fuzzy" }}
                   style="accent-color:var(--accent);">
            Closest match
          </label>
        </div>
        <div style="font-size:0.78rem; color:var(--muted); margin-top:0.25rem;">Literal: all words required · Closest: any word, ranked by coverage</div>
      </div>
      <button class="filter-btn" type="submit">Apply Filters</button>
      <a href="/"><button class="clear-btn" type="button">Clear All</button></a>
    </form>
  </aside>

  <main>
    {% if nlq_detected %}
    <div style="background:#fdf8f0; border:1px solid #d4b896; border-radius:6px;
                padding:0.6rem 1rem; margin-bottom:1rem; font-size:0.85rem;
                display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
      <span style="color:var(--muted);">&#128269; Detected in query:</span>
      {% for dim, val in nlq_detected.items() %}
        {% if dim == "theme" %}
          {% for v in val %}<span class="tag" style="font-size:0.78rem;">{{ dim }}: {{ v }}</span>{% endfor %}
        {% else %}
          <span class="tag" style="font-size:0.78rem;">{{ dim }}: {{ val }}</span>
        {% endif %}
      {% endfor %}
      {% if nlq_url %}
      <a href="{{ nlq_url }}"
         style="margin-left:auto; background:var(--accent2); color:#fff;
                padding:0.2rem 0.7rem; border-radius:4px; text-decoration:none;
                font-size:0.82rem; white-space:nowrap;">
        Apply as filters &rarr;
      </a>
      {% endif %}
    </div>
    {% endif %}
    <div class="results-header">
      <span>{{ total }} stories{% if q %} matching <em>"{{ q }}"</em>{% endif %}</span>
      <span>Page {{ page }} of {{ total_pages }}</span>
    </div>

    <div class="story-grid">
    {% for s in results %}
    {% set at = s.auto_tags or {} %}
    {% set cats = s.categories %}
    {% set is_liked_story  = prefs and prefs.story_status(s.id) == 'liked' %}
    {% set is_liked_author = prefs and s.author in prefs.liked_authors %}
    {% set is_fave = ('md' in cats or 'mc' in cats) and 'mf' in cats %}
    {% set visit = prefs.visit_info(s.id) if prefs else none %}
    {% if is_fave and is_liked_author %}{% set card_class = "pref-fave pref-author-fave" %}
    {% elif is_fave %}{% set card_class = "pref-fave" %}
    {% elif is_liked_author %}{% set card_class = "pref-author" %}
    {% elif is_liked_story %}{% set card_class = "pref-liked" %}
    {% else %}{% set card_class = "" %}{% endif %}
    <div class="story-card {{ card_class }}">
      <div class="story-title">
        <a href="/story/{{ s.id }}">{{ s | dt }}</a>
        {% if is_fave and is_liked_author %}<span class="pref-badge badge-fave">&#9733; fave · liked author</span>
        {% elif is_fave %}<span class="pref-badge badge-fave">&#9733; fave type</span>
        {% elif is_liked_author %}<span class="pref-badge badge-author">&#9733; liked author</span>
        {% elif is_liked_story %}<span class="pref-badge badge-liked">&#9829; liked</span>
        {% endif %}
        {% if visit %}
          {% if visit.total > 1 %}
          <span class="pref-badge badge-history">&#9654; Ch {{ visit.last_chapter }}/{{ visit.total }}</span>
          {% else %}
          <span class="pref-badge badge-history">&#9654; read</span>
          {% endif %}
        {% endif %}
        {% if s.source == "wayback" %}<span class="pref-badge" style="background:#2a3a4a;color:#8ab4d4;border:1px solid #4a7a9a;">&#8984; archived</span>{% endif %}
        {% if prefs and prefs.is_wanted(s.id) %}<span class="pref-badge badge-wtr">&#128278; want to read</span>{% endif %}
      </div>
      <div class="story-meta">
        <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author or "Unknown" }}</a></span>
        <span>{{ "{:,}".format(s.word_count) }} words</span>
        {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} chapters</span>{% endif %}
        {% if s.added_date %}<span>{{ s.added_date }}</span>{% endif %}
        {% if at.get("length_class") %}<span class="mono">{{ at.length_class }}</span>{% endif %}
        {% if at.get("pov") %}<span class="mono">{{ at.pov }}</span>{% endif %}
      </div>
      <div>
        {% for cat in cats[:6] %}
        <a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>
        {% endfor %}
        {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}
        <span class="tag mc-type">{{ mc }}</span>
        {% endfor %}
        {% for d in visible_tags(at.get("dominance") or [], at)[:1] %}
        <span class="tag" style="color:#c8a06a">{{ d }}</span>
        {% endfor %}
        {% for p in visible_tags(at.get("pacing") or [], at)[:1] %}
        <span class="tag" style="color:#7a9e7a">{{ p }}</span>
        {% endfor %}
        {% for a in visible_tags(at.get("awareness") or [], at)[:1] %}
        <span class="tag" style="color:#8a9abf">{{ a }}</span>
        {% endfor %}
      </div>
      {% if s.description %}
      <div class="story-desc">{{ s.description }}</div>
      {% endif %}
      <div style="margin-top:0.4rem; display:flex; align-items:center; flex-wrap:wrap; gap:0.25rem;">
        {% if prefs %}
        {% set status = prefs.story_status(s.id) %}
        <button onclick="cardLike(this,'{{ s.id }}','liked')"
                style="background:{{ '#e8f4e8' if status=='liked' else 'transparent' }};
                       border:1px solid {{ '#4a8a4a' if status=='liked' else 'var(--border)' }};
                       color:{{ '#2a5a2a' if status=='liked' else 'var(--muted)' }};
                       padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                       font-size:0.75rem; font-family:inherit;">
          {{ "♥" if status=='liked' else "♡" }} Like
        </button>
        {% if status == 'liked' %}
        <button onclick="cardLike(this,'{{ s.id }}','none')"
                style="background:transparent; border:1px solid var(--border);
                       color:var(--muted); padding:0.15rem 0.6rem; border-radius:3px;
                       cursor:pointer; font-size:0.75rem; font-family:inherit;">
          ✕ Unlike
        </button>
        {% endif %}
        {% endif %}
        {% if prefs %}
        <button class="want-btn" data-wanted="{{ '1' if prefs.is_wanted(s.id) else '0' }}"
                onclick="cardWant(this,'{{ s.id }}')"
                style="background:{{ '#e8f4e8' if prefs.is_wanted(s.id) else 'transparent' }};
                       border:1px solid {{ '#4a7a4a' if prefs.is_wanted(s.id) else 'var(--border)' }};
                       color:{{ '#2a5a2a' if prefs.is_wanted(s.id) else 'var(--muted)' }};
                       padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                       font-size:0.75rem; font-family:inherit;">
          &#128278; {{ "Wanted" if prefs.is_wanted(s.id) else "Want" }}
        </button>
        {% endif %}
        <button class="preview-btn" onclick="togglePreview(this,'{{ s.id }}')">&#9656; Preview</button>
      </div>
      <div class="preview-box" id="preview-{{ s.id }}"></div>
    </div>
    {% else %}
    <p style="color:var(--muted); margin-top:2rem;">No stories found. Try adjusting your filters.</p>
    {% endfor %}
    </div>

<script>
function cardLike(btn, id, status) {
  fetch('/api/like/' + id, {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({status: status})})
  .then(r => r.json()).then(d => {
    if (d.ok) {
      var card = btn.closest('.story-card');
      var wrap = btn.parentElement;
      if (status === 'liked') {
        btn.innerHTML = '♥ Like';
        btn.style.background = '#e8f4e8';
        btn.style.borderColor = '#4a8a4a';
        btn.style.color = '#2a5a2a';
        btn.onclick = function(){ cardLike(btn, id, 'none'); };
        if (!wrap.querySelector('.unlike-btn')) {
          var u = document.createElement('button');
          u.className = 'unlike-btn';
          u.innerHTML = '✕ Unlike';
          u.style.cssText = 'background:transparent;border:1px solid var(--border);color:var(--muted);padding:0.15rem 0.6rem;border-radius:3px;cursor:pointer;font-size:0.75rem;font-family:inherit;';
          u.onclick = function(){ cardLike(u, id, 'none'); };
          wrap.insertBefore(u, wrap.querySelector('.preview-btn'));
        }
        // update badge
        var badge = card.querySelector('.pref-badge.badge-liked');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'pref-badge badge-liked';
          card.querySelector('.story-title').appendChild(badge);
        }
        badge.textContent = '♥ liked';
      } else {
        btn.innerHTML = '♡ Like';
        btn.style.background = 'transparent';
        btn.style.borderColor = 'var(--border)';
        btn.style.color = 'var(--muted)';
        btn.onclick = function(){ cardLike(btn, id, 'liked'); };
        var u = wrap.querySelector('.unlike-btn');
        if (u) u.remove();
      }
    }
  });
}

// ── Story preview ──────────────────────────────────────────────────────────
var _previewCache = {};
function togglePreview(btn, id) {
  var box = document.getElementById('preview-' + id);
  if (box.classList.contains('open')) {
    box.classList.remove('open');
    btn.innerHTML = '&#9656; Preview';
    return;
  }
  btn.innerHTML = '&#9660; Preview';
  box.classList.add('open');
  if (_previewCache[id]) { renderPreview(box, _previewCache[id]); return; }
  box.textContent = 'Loading…';
  fetch('/api/preview/' + id)
    .then(r => r.json())
    .then(d => {
      _previewCache[id] = d.text || '';
      renderPreview(box, _previewCache[id]);
    })
    .catch(() => { box.textContent = 'Preview unavailable.'; });
}
function renderPreview(box, text) {
  var q = (new URLSearchParams(window.location.search)).get('q') || '';
  if (q) {
    var words = q.trim().split(' ').filter(Boolean)
                 .map(w => w.replace(/[.*+?^$()|]/g, '\\$1'));
    var re = new RegExp('(' + words.join('|') + ')', 'gi');
    box.innerHTML = text.replace(/&/g,'&amp;').replace(/</g,'&lt;')
                        .replace(re, '<mark class="hl">$1</mark>');
  } else {
    box.textContent = text;
  }
}
</script>

    {% if total_pages > 1 %}
    <div class="pagination">
      {% if page > 1 %}<a href="?{{ params }}&page={{ page-1 }}">&laquo;</a>{% endif %}
      {% for p in range([1, page-3]|max, [total_pages+1, page+4]|min) %}
        {% if p == page %}<span class="current">{{ p }}</span>
        {% else %}<a href="?{{ params }}&page={{ p }}">{{ p }}</a>{% endif %}
      {% endfor %}
      {% if page < total_pages %}<a href="?{{ params }}&page={{ page+1 }}">&raquo;</a>{% endif %}
    </div>
    {% endif %}
  </main>
</div>
{% endblock %}
''')

STORY_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="max-width:1060px">
  <div class="reader-header">
    <div class="reader-title">{{ story | dt }}</div>
    <div class="reader-meta">
      by <a href="/author/{{ story.author | urlencode }}">{{ story.author }}</a>
      {% if story.word_count %} · {{ "{:,}".format(story.word_count) }} words{% endif %}
      {% if story.added_date %} · Added {{ story.added_date }}{% endif %}
      {% if (story.chapter_count | default(0)) > 1 %} · {{ story.chapter_count }} chapters{% endif %}
    </div>
    <div class="reader-tags" style="margin-top:0.6rem">
      {% for cat in story.categories %}
      <a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>
      {% endfor %}
      {% set at = story.auto_tags or {} %}
      {% for mc in visible_tags(at.get("mind_control_type", []), at) %}
      <span class="tag mc-type">{{ mc }}</span>
      {% endfor %}
      {% for s in at.get("setting", []) %}
      <span class="tag" style="color:#8ab4c8">{{ s }}</span>
      {% endfor %}
      {% for t in visible_tags(at.get("themes", []), at) %}
      <span class="tag" style="color:#a0c898">{{ t }}</span>
      {% endfor %}
      {% if at.get("tone") %}<span class="tag">{{ at.tone[0] }}</span>{% endif %}
      {% if at.get("pov") %}<span class="tag mono">{{ at.pov }}</span>{% endif %}
      {% if at.get("length_class") %}<span class="tag mono">{{ at.length_class }}</span>{% endif %}
      {% for x in visible_tags(at.get("sexual_acts", []), at) %}
      <span class="tag" style="color:#b87070">{{ x }}</span>
      {% endfor %}
      {% for x in at.get("fetish", []) %}
      <span class="tag" style="color:#9070b8">{{ x }}</span>
      {% endfor %}
      {% for x in visible_tags(at.get("relationship", []), at) %}
      <span class="tag" style="color:#70a0b8">{{ x }}</span>
      {% endfor %}
    </div>
    {% if story.description %}
    <p style="margin-top:0.75rem; font-style:italic; color:#a89880; font-size:0.95rem">
      {{ story.description }}</p>
    {% endif %}
    <div style="margin-top:0.75rem; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
      <a href="{{ story.story_url }}" target="_blank"
         style="font-size:0.82rem; color:var(--muted);">&#8599; View on mcstories.com</a>
      <span style="display:flex; gap:0.25rem; align-items:center;">
        <button onclick="adjFont(-1)" title="Smaller text"
                style="background:none;border:1px solid var(--border);color:var(--muted);
                       padding:0.1rem 0.55rem;border-radius:3px;cursor:pointer;
                       font-size:0.85rem;font-family:inherit;">A−</button>
        <button onclick="adjFont(1)"  title="Larger text"
                style="background:none;border:1px solid var(--border);color:var(--muted);
                       padding:0.1rem 0.55rem;border-radius:3px;cursor:pointer;
                       font-size:1.05rem;font-family:inherit;">A+</button>
      </span>
      <span style="display:flex; gap:0.5rem; align-items:center;">
        <button onclick="setLike('liked')"
                style="background:{{ '#e8f4e8' if story_status=='liked' else 'var(--bg2)' }};
                       border:1px solid {{ '#4a8a4a' if story_status=='liked' else 'var(--border)' }};
                       color:{{ '#2a5a2a' if story_status=='liked' else 'var(--muted)' }};
                       padding:0.3rem 0.8rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.88rem;">
          &#9829; {{ "Liked" if story_status=="liked" else "Like" }}
        </button>
        <button onclick="setLike('disliked')"
                style="background:{{ '#f4e8e8' if story_status=='disliked' else 'var(--bg2)' }};
                       border:1px solid {{ '#8a4a4a' if story_status=='disliked' else 'var(--border)' }};
                       color:{{ '#5a2a2a' if story_status=='disliked' else 'var(--muted)' }};
                       padding:0.3rem 0.8rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.88rem;">
          &#128078; Not for me
        </button>
        {% if story_status != 'none' %}
        <button onclick="setLike('none')"
                style="background:none; border:none; color:var(--muted); cursor:pointer;
                       font-size:0.82rem; font-family:inherit;">&#10005; Clear</button>
        {% endif %}
      </span>
      {% if prefs %}
      <span style="display:flex; gap:0.5rem; align-items:center;">
        <button id="want-btn" data-wanted="{{ '1' if prefs.is_wanted(story.id) else '0' }}"
                onclick="setWant()"
                style="background:{{ '#e8f4e8' if prefs.is_wanted(story.id) else 'var(--bg2)' }};
                       border:1px solid {{ '#4a7a4a' if prefs.is_wanted(story.id) else 'var(--border)' }};
                       color:{{ '#2a5a2a' if prefs.is_wanted(story.id) else 'var(--muted)' }};
                       padding:0.3rem 0.8rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.88rem;">
          &#128278; {{ "Wanted" if prefs.is_wanted(story.id) else "Want to read" }}
        </button>
      </span>
      {% endif %}
    </div>
    <div style="margin-top:0.5rem; font-size:0.88rem; display:flex; gap:1.5rem;">
      <a href="/similar/{{ story.id }}">&#8801; Similar stories</a>
      <a href="/author-similar/{{ story.author | urlencode }}">&#9768; Authors like {{ story.author }}</a>
    </div>
  </div>

  <script>
  function setLike(status) {
    fetch('/api/like/{{ story.id }}', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({status: status})
    }).then(r => r.json()).then(d => { if (d.ok) location.reload(); });
  }
  function setWant() {
    var btn = document.getElementById('want-btn');
    var wanted = btn.dataset.wanted === '1';
    fetch('/api/want/{{ story.id }}', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({wanted: !wanted})
    }).then(r => r.json()).then(d => {
      if (d.ok) {
        btn.dataset.wanted = d.wanted ? '1' : '0';
        btn.innerHTML = d.wanted ? '&#128278; Wanted' : '&#128278; Want to read';
        btn.style.background = d.wanted ? '#e8f4e8' : 'var(--bg2)';
        btn.style.borderColor = d.wanted ? '#4a7a4a' : 'var(--border)';
        btn.style.color = d.wanted ? '#2a5a2a' : 'var(--muted)';
      }
    });
  }
  </script>

  {% if chapters|length > 1 %}
  <div class="chapter-nav" id="chapter-nav-top">
    {% for i, label in chapters %}
    <button class="chapter-btn {{ 'active' if i==current_ch }}"
            onclick="showChapter({{ i }}, false)">{{ label }}</button>
    {% endfor %}
  </div>
  {% endif %}

  <div class="story-text" id="story-body">
    {% for i, chunk in chapter_chunks %}
    <div class="chapter-chunk" id="ch-{{ i }}"
         style="{{ 'display:none' if i != current_ch }}">
      {% if chapters|length > 1 %}
      <div class="chapter-divider">— Chapter {{ i }} —</div>
      {% endif %}
      {{ chunk | safe }}
    </div>
    {% endfor %}
  </div>

  {% if chapters|length > 1 %}
  <div class="chapter-nav" id="chapter-nav-bottom" style="margin-top:2rem; margin-bottom:1rem;">
    {% for i, label in chapters %}
    <button class="chapter-btn {{ 'active' if i==current_ch }}"
            onclick="showChapter({{ i }}, true)">{{ label }}</button>
    {% endfor %}
  </div>
  {% endif %}
</div>

{% if similar %}
<div style="margin-top:3rem; border-top:1px solid var(--border); padding-top:1.5rem;">
  <div style="font-size:0.78rem; color:var(--muted); letter-spacing:0.1em;
              text-transform:uppercase; margin-bottom:1rem;">Similar stories</div>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:0.75rem;">
  {% for sim, score in similar %}
  <div style="background:var(--bg2); border:1px solid var(--border); border-radius:6px; padding:0.75rem;">
    <div style="font-size:0.95rem; margin-bottom:0.2rem;">
      <a href="/story/{{ sim.id }}">{{ sim | dt }}</a>
    </div>
    <div style="font-size:0.8rem; color:var(--muted);">
      {{ sim.author }} &middot; {{ "{:,}".format(sim.word_count) }} words
    </div>
    {% set at2 = sim.auto_tags or {} %}
    <div style="margin-top:0.3rem;">
      {% for mc in (at2.get("mind_control_type") or [])[:2] %}
      <span class="tag mc-type" style="font-size:0.72rem;">{{ mc }}</span>
      {% endfor %}
      {% for t in (at2.get("themes") or [])[:2] %}
      <span class="tag" style="font-size:0.72rem; color:#a0c898;">{{ t }}</span>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
  </div>
  <p style="margin-top:0.75rem; font-size:0.82rem;">
    <a href="/similar/{{ story.id }}">See all similar stories &rarr;</a>
  </p>
</div>
{% endif %}

<script>
var _currentChapter = {{ current_ch }};
var _totalChapters  = {{ chapters|length }};
var _storyId        = "{{ story.id }}";

// ── Font size controls ─────────────────────────────────────────────────────
var _fontSizes = [0.85, 0.90, 0.95, 1.0, 1.05, 1.10, 1.15, 1.20, 1.30, 1.40, 1.55, 1.70];
var _fontIdx   = _fontSizes.indexOf(1.15);  // default matches CSS
(function() {
  var saved = parseFloat(localStorage.getItem('mc_font_size'));
  if (saved) {
    var i = _fontSizes.indexOf(saved);
    if (i !== -1) _fontIdx = i;
    document.getElementById('story-body').style.fontSize = _fontSizes[_fontIdx] + 'rem';
  }
})();
function adjFont(dir) {
  _fontIdx = Math.max(0, Math.min(_fontSizes.length - 1, _fontIdx + dir));
  var sz = _fontSizes[_fontIdx] + 'rem';
  document.getElementById('story-body').style.fontSize = sz;
  localStorage.setItem('mc_font_size', _fontSizes[_fontIdx]);
}

function showChapter(n, scrollToTop) {
  document.querySelectorAll(".chapter-chunk").forEach(el => el.style.display = "none");
  document.getElementById("ch-"+n).style.display = "block";
  document.querySelectorAll("#chapter-nav-top .chapter-btn").forEach((btn, i) =>
    btn.classList.toggle("active", i === n-1));
  document.querySelectorAll("#chapter-nav-bottom .chapter-btn").forEach((btn, i) =>
    btn.classList.toggle("active", i === n-1));
  _currentChapter = n;
  if (scrollToTop) {
    window.scrollTo(0, document.getElementById("chapter-nav-top").offsetTop - 80);
  }
  fetch('/api/history/' + _storyId, {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({chapter: n, total: _totalChapters})
  });
}
// Record initial visit on page load
fetch('/api/history/' + _storyId, {
  method: 'POST', headers: {'Content-Type': 'application/json'},
  body: JSON.stringify({chapter: _currentChapter, total: _totalChapters})
});

{% if chapters|length > 1 %}
document.addEventListener("keydown", function(e) {
  if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
  if (e.key === "ArrowRight" || e.key === "ArrowDown") {
    if (_currentChapter < _totalChapters) { e.preventDefault(); showChapter(_currentChapter + 1, true); }
  } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
    if (_currentChapter > 1) { e.preventDefault(); showChapter(_currentChapter - 1, true); }
  }
});
{% endif %}
</script>
{% endblock %}
''')

AUTHORS_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">Authors ({{ authors|length }})</h1>
<div style="columns: 3; gap: 2rem; font-size:0.92rem;">
{% for author, count in authors %}
<div style="break-inside:avoid; margin-bottom:0.4rem">
  <a href="/author/{{ author | urlencode }}">{{ author }}</a>
  <span style="color:var(--muted)"> · {{ count }}</span>
</div>
{% endfor %}
</div>
{% endblock %}
''')

AUTHOR_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; align-items:center; gap:1.5rem; margin-bottom:0.5rem;">
  <h1 class="page-title" style="margin:0;border:none;">{{ author }}</h1>
  <button id="follow-btn" onclick="toggleFollow()"
          style="background:{{ '#e8f4e8' if author_status=='liked' else 'var(--bg2)' }};
                 border:1px solid {{ '#4a8a4a' if author_status=='liked' else 'var(--border)' }};
                 color:{{ '#2a5a2a' if author_status=='liked' else 'var(--muted)' }};
                 padding:0.3rem 0.9rem; border-radius:4px; cursor:pointer;
                 font-family:inherit; font-size:0.88rem;">
    {{ "★ Following" if author_status=='liked' else "☆ Follow" }}
  </button>
  <a href="/author-similar/{{ author | urlencode }}"
     style="font-size:0.88rem; color:var(--muted);">Similar authors &rarr;</a>
</div>
<p style="color:var(--muted); margin-bottom:1.5rem">{{ stories|length }} stories</p>
<script>
function toggleFollow() {
  const isFollowing = document.getElementById('follow-btn').textContent.includes('Following');
  fetch('/api/like-author/{{ author | urlencode }}', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({status: isFollowing ? 'none' : 'liked'})
  }).then(r => r.json()).then(d => { if(d.ok) location.reload(); });
}
</script>
<div class="story-grid">
{% for s in stories %}
{% set visit = prefs.visit_info(s.id) if prefs else none %}
<div class="story-card">
  <div class="story-title">
    <a href="/story/{{ s.id }}">{{ s | dt }}</a>
    {% if visit %}
      {% if visit.total > 1 %}
      <span class="pref-badge badge-history">&#9654; Ch {{ visit.last_chapter }}/{{ visit.total }}</span>
      {% else %}
      <span class="pref-badge badge-history">&#9654; read</span>
      {% endif %}
    {% endif %}
    {% if prefs and prefs.is_wanted(s.id) %}<span class="pref-badge badge-wtr">&#128278; want to read</span>{% endif %}
  </div>
  <div class="story-meta">
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} ch</span>{% endif %}
    {% if s.added_date %}<span>{{ s.added_date }}</span>{% endif %}
  </div>
  <div>{% for cat in s.categories[:8] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}</div>
  {% if s.description %}<div class="story-desc">{{ s.description }}</div>{% endif %}
  <div style="margin-top:0.4rem; display:flex; align-items:center; flex-wrap:wrap; gap:0.25rem;">
    {% if prefs %}
    {% set status = prefs.story_status(s.id) %}
    <button onclick="cardLike(this,'{{ s.id }}','liked')"
            style="background:{{ '#e8f4e8' if status=='liked' else 'transparent' }};
                   border:1px solid {{ '#4a8a4a' if status=='liked' else 'var(--border)' }};
                   color:{{ '#2a5a2a' if status=='liked' else 'var(--muted)' }};
                   padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                   font-size:0.75rem; font-family:inherit;">
      {{ "♥" if status=='liked' else "♡" }} Like
    </button>
    {% if status == 'liked' %}
    <button onclick="cardLike(this,'{{ s.id }}','none')"
            style="background:transparent; border:1px solid var(--border);
                   color:var(--muted); padding:0.15rem 0.6rem; border-radius:3px;
                   cursor:pointer; font-size:0.75rem; font-family:inherit;">
      ✕ Unlike
    </button>
    {% endif %}
    {% endif %}
    {% if prefs %}
    <button class="want-btn" data-wanted="{{ '1' if prefs.is_wanted(s.id) else '0' }}"
            onclick="cardWant(this,'{{ s.id }}')"
            style="background:{{ '#e8f4e8' if prefs.is_wanted(s.id) else 'transparent' }};
                   border:1px solid {{ '#4a7a4a' if prefs.is_wanted(s.id) else 'var(--border)' }};
                   color:{{ '#2a5a2a' if prefs.is_wanted(s.id) else 'var(--muted)' }};
                   padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                   font-size:0.75rem; font-family:inherit;">
      &#128278; {{ "Wanted" if prefs.is_wanted(s.id) else "Want" }}
    </button>
    {% endif %}
    <button class="preview-btn" onclick="togglePreview(this,'{{ s.id }}')">&#9656; Preview</button>
  </div>
  <div class="preview-box" id="preview-{{ s.id }}"></div>
</div>
{% endfor %}
</div>
<script>
function cardLike(btn, id, status) {
  fetch('/api/like/' + id, {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({status: status})})
  .then(r => r.json()).then(d => {
    if (d.ok) {
      var wrap = btn.parentElement;
      if (status === 'liked') {
        btn.innerHTML = '♥ Like';
        btn.style.background = '#e8f4e8';
        btn.style.borderColor = '#4a8a4a';
        btn.style.color = '#2a5a2a';
        btn.onclick = function(){ cardLike(btn, id, 'none'); };
        if (!wrap.querySelector('.unlike-btn')) {
          var u = document.createElement('button');
          u.className = 'unlike-btn';
          u.innerHTML = '✕ Unlike';
          u.style.cssText = 'background:transparent;border:1px solid var(--border);color:var(--muted);padding:0.15rem 0.6rem;border-radius:3px;cursor:pointer;font-size:0.75rem;font-family:inherit;';
          u.onclick = function(){ cardLike(u, id, 'none'); };
          var pb = wrap.querySelector('.preview-btn');
          pb ? wrap.insertBefore(u, pb) : wrap.appendChild(u);
        }
      } else {
        btn.innerHTML = '♡ Like';
        btn.style.background = 'transparent';
        btn.style.borderColor = 'var(--border)';
        btn.style.color = 'var(--muted)';
        btn.onclick = function(){ cardLike(btn, id, 'liked'); };
        var u = wrap.querySelector('.unlike-btn');
        if (u) u.remove();
      }
    }
  });
}
</script>
{% endblock %}
''')

_AUTO_DIM_LABELS = {
    "mind_control_type": ("MC Method",       "mc_type"),
    "setting":           ("Setting",         "setting"),
    "themes":            ("Themes",          "theme"),
    "tone":              ("Tone",            "tone"),
    "dominance":         ("Dominance Style", "dominance"),
    "pacing":            ("Pacing",          "pacing"),
    "awareness":         ("Victim Awareness","awareness"),
    "sexual_acts":       ("Sexual Acts",     "sexual_act"),
    "fetish":            ("Fetish",          "fetish_tag"),
    "relationship":      ("Relationship",    "relationship"),
}

TAGS_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">Tags &amp; Categories</h1>

<h2 style="font-size:1.1rem; font-weight:400; color:var(--accent); margin:0 0 0.75rem;">
  mcstories.com Category Codes</h2>
<div class="tag-cloud" style="margin-bottom:2.5rem">
{% for tag, count in tags %}
<a href="/tag/{{ tag }}" class="tag-cloud-item">
  <span class="mono">{{ tag }}</span> <span style="color:var(--muted)">{{ count }}</span>
</a>
{% endfor %}
</div>

<h2 style="font-size:1.1rem; font-weight:400; color:var(--accent); margin:0 0 1rem;">
  Auto-generated Tags</h2>
{% for dim, items in auto_tags.items() %}
{% set meta = dim_meta.get(dim, (dim, dim)) %}
<div style="margin-bottom:1.75rem">
  <h3 style="font-size:0.85rem; font-weight:600; text-transform:uppercase;
             letter-spacing:.08em; color:var(--muted); margin:0 0 0.5rem;">
    {{ meta[0] }}</h3>
  <div class="tag-cloud">
  {% for val, count in items %}
  <a href="/search?{{ meta[1] }}={{ val | urlencode }}" class="tag-cloud-item">
    {{ val }} <span style="color:var(--muted)">{{ count }}</span>
  </a>
  {% endfor %}
  </div>
</div>
{% endfor %}
{% endblock %}
''')

STATS_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">Dataset Statistics</h1>
<div class="stats-grid" style="margin-bottom:2rem">
  <div class="stat-card"><span class="stat-value">{{ "{:,}".format(stats.total) }}</span><div class="stat-label">Stories</div></div>
  <div class="stat-card"><span class="stat-value">{{ "{:,}".format(stats.authors) }}</span><div class="stat-label">Authors</div></div>
  <div class="stat-card"><span class="stat-value">{{ "{:,.0f}".format(stats.avg_words) }}</span><div class="stat-label">Avg words</div></div>
  <div class="stat-card"><span class="stat-value">{{ stats.total_words_m }}M</span><div class="stat-label">Total words</div></div>
  <div class="stat-card"><span class="stat-value">{{ stats.multi_chapter }}</span><div class="stat-label">Multi-chapter</div></div>
  <div class="stat-card"><span class="stat-value">{{ stats.errors }}</span><div class="stat-label">Fetch errors</div></div>
</div>
<h2 style="font-size:1.1rem; color:var(--muted); margin-bottom:1rem; font-weight:400">Top Tags</h2>
<div class="tag-cloud">
{% for tag, count in stats.top_tags %}
<a href="/tag/{{ tag }}" class="tag-cloud-item">
  <span class="mono">{{ tag }}</span> <span style="color:var(--muted)">{{ count }}</span>
</a>
{% endfor %}
</div>
{% endblock %}
''')


SIMILAR_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">Stories similar to &ldquo;{{ story | dt }}&rdquo;</h1>
<div style="color:var(--muted); margin-bottom:1.5rem; font-size:0.9rem;
            display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
  <span>by {{ story.author }}</span>
  {% if story.word_count %}
  <span>{{ "{:,}".format(story.word_count) }} words</span>
  {% set half_wc  = (story.word_count // 2) | int %}
  {% set twice_wc = (story.word_count * 2) | int %}
  <span style="display:flex; gap:0.4rem;">
    {% if half_wc > 0 %}
    <a href="/similar/{{ story.id }}?max_words={{ half_wc }}"
       style="font-size:0.8rem; background:var(--bg3); border:1px solid var(--border);
              color:var(--muted); padding:0.15rem 0.55rem; border-radius:4px;
              text-decoration:none;" title="Show only stories shorter than half this length">
      &darr; shorter
    </a>
    {% endif %}
    <a href="/similar/{{ story.id }}?min_words={{ twice_wc }}"
       style="font-size:0.8rem; background:var(--bg3); border:1px solid var(--border);
              color:var(--muted); padding:0.15rem 0.55rem; border-radius:4px;
              text-decoration:none;" title="Show only stories longer than twice this length">
      &uarr; longer
    </a>
    {% if request.args.get("max_words") or request.args.get("min_words") %}
    <a href="/similar/{{ story.id }}"
       style="font-size:0.8rem; background:var(--bg3); border:1px solid var(--border);
              color:var(--muted); padding:0.15rem 0.55rem; border-radius:4px;
              text-decoration:none;">&#215; clear</a>
    {% endif %}
  </span>
  {% endif %}
  {% if not index_ready %}
  <span style="color:var(--accent2)">&#9203; Building similarity index&hellip; refresh in a moment</span>
  {% endif %}
</div>
<div class="story-grid">
{% for sim, score in results %}
<div class="story-card">
  <div style="display:flex; justify-content:space-between; align-items:flex-start;">
    <div class="story-title"><a href="/story/{{ sim.id }}">{{ sim | dt }}</a></div>
    <div style="font-size:0.75rem; color:var(--muted); font-family:monospace; white-space:nowrap; padding-left:1rem;">
      {{ "%.0f"|format(score*100) }}% match
    </div>
  </div>
  <div class="story-meta">
    <span>by <a href="/author/{{ sim.author | urlencode }}">{{ sim.author }}</a></span>
    <span>{{ "{:,}".format(sim.word_count) }} words</span>
    {% if (sim.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ sim.chapter_count }} ch</span>{% endif %}
  </div>
  {% set at = sim.auto_tags or {} %}
  <div>
    {% for cat in sim.categories[:5] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}<span class="tag mc-type">{{ mc }}</span>{% endfor %}
    {% for t in visible_tags(at.get("themes") or [], at)[:2] %}<span class="tag" style="color:#a0c898;font-size:0.75rem;">{{ t }}</span>{% endfor %}
    {% for d in visible_tags(at.get("dominance") or [], at)[:1] %}<span class="tag" style="color:#c8a06a;font-size:0.75rem;">{{ d }}</span>{% endfor %}
  </div>
  {% if sim.description %}<div class="story-desc">{{ sim.description }}</div>{% endif %}
</div>
{% else %}
<p style="color:var(--muted)">
  {% if not index_ready %}Building index&hellip; refresh in 10 seconds{% else %}No similar stories found{% endif %}
</p>
{% endfor %}
</div>
{% endblock %}
''')

RECS_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1.5rem;">
  <h1 class="page-title" style="margin:0; border:none;">For You</h1>
  <span style="display:flex; align-items:center; gap:1rem; font-size:0.82rem; color:var(--muted);">
    Based on {{ liked_count }} likes
    {% if not semantic %}&nbsp;&middot;&nbsp;
    <span style="color:var(--accent2)">Install sentence-transformers for better results</span>
    {% endif %}
    <a href="/recommendations?shuffle=1"
       style="background:var(--bg3); border:1px solid var(--border); color:var(--muted);
              padding:0.25rem 0.7rem; border-radius:4px; text-decoration:none; font-size:0.82rem;
              cursor:pointer;" title="Show a different random selection from your top matches">
      &#8635; Shuffle
    </a>
  </span>
</div>

{% if liked_count == 0 %}
<div style="background:var(--bg2); border:1px solid var(--border); border-radius:6px;
            padding:2rem; text-align:center; margin-bottom:2rem;">
  <p style="font-size:1.1rem; margin-bottom:0.75rem;">Like some stories to get personalised recommendations</p>
  <p style="color:var(--muted); font-size:0.9rem;">
    Open any story and click &#9829; Like. The more you like, the better the recommendations get.
  </p>
  <p style="margin-top:1rem;"><a href="/">Browse stories &rarr;</a></p>
</div>
{% endif %}

{% if profile %}
<div style="background:var(--bg2); border:1px solid var(--border); border-radius:6px;
            padding:1.25rem; margin-bottom:2rem;">
  <div style="font-size:0.78rem; color:var(--muted); letter-spacing:0.1em;
              text-transform:uppercase; margin-bottom:0.75rem;">Your taste profile</div>
  <div style="display:flex; flex-wrap:wrap; gap:1.5rem; font-size:0.88rem;">
    {% if profile.top_themes %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">Themes</div>
      {% for t, n in profile.top_themes %}
      <span class="tag" style="color:#a0c898;">{{ t }}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% if profile.top_mc_types %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">MC methods</div>
      {% for t, n in profile.top_mc_types %}
      <span class="tag mc-type">{{ t }}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% if profile.top_dominance %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">Dominance style</div>
      {% for t, n in profile.top_dominance %}
      <span class="tag" style="color:#c8a06a;">{{ t }}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% if profile.top_pacing %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">Pacing</div>
      {% for t, n in profile.top_pacing %}
      <span class="tag" style="color:#7a9e7a;">{{ t }}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% if profile.avg_length %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">Avg length liked</div>
      <span style="color:var(--text);">{{ "{:,}".format(profile.avg_length) }} words</span>
    </div>
    {% endif %}
    {% if profile.liked_authors %}
    <div>
      <div style="color:var(--muted); font-size:0.78rem; margin-bottom:0.3rem;">Liked authors</div>
      {% for a in profile.liked_authors[:4] %}
      <a href="/author/{{ a | urlencode }}" class="tag">{{ a }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
{% endif %}

{% if not index_ready %}
<p style="color:var(--accent2); margin-bottom:1rem; font-size:0.9rem;">
  &#9203; Building similarity index&hellip; refresh in a moment for personalised ranking
</p>
{% endif %}

<div class="story-grid" id="recs-grid">
{% for s, score, reason in recs %}
<div class="story-card" id="rec-{{ s.id }}">
  <div style="display:flex; justify-content:space-between; align-items:flex-start;">
    <div class="story-title"><a href="/story/{{ s.id }}">{{ s | dt }}</a></div>
    <button onclick="dismissRec('{{ s.id }}')"
            title="Remove from recommendations"
            style="background:none; border:none; color:var(--muted); cursor:pointer;
                   font-size:1rem; padding:0 0.2rem; line-height:1; opacity:0.5; flex-shrink:0;"
            onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.5'">✕</button>
  </div>
  <div class="story-meta">
    <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author }}</a></span>
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} ch</span>{% endif %}
  </div>
  {% set at = s.auto_tags or {} %}
  <div>
    {% for cat in s.categories[:5] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}<span class="tag mc-type">{{ mc }}</span>{% endfor %}
    {% for t in visible_tags(at.get("themes") or [], at)[:2] %}<span class="tag" style="color:#a0c898;font-size:0.75rem;">{{ t }}</span>{% endfor %}
    {% for d in visible_tags(at.get("dominance") or [], at)[:1] %}<span class="tag" style="color:#c8a06a;font-size:0.75rem;">{{ d }}</span>{% endfor %}
  </div>
  {% if s.description %}<div class="story-desc">{{ s.description }}</div>{% endif %}
  {% if reason %}<div style="font-size:0.8rem; color:var(--muted); font-style:italic; margin-top:0.4rem;">because: {{ reason }}</div>{% endif %}
</div>
{% else %}
<p style="color:var(--muted)">No recommendations yet — like some stories first.</p>
{% endfor %}
</div>
{% if hidden_count %}
<p style="margin-top:1.5rem; font-size:0.82rem; color:var(--muted); text-align:center;">
  {{ hidden_count }} stories hidden &middot;
  <a href="/api/restore-dismissed" onclick="restoreDismissed(event)"
     style="color:var(--muted);">Restore all</a>
</p>
{% endif %}
<script>
function dismissRec(id) {
  fetch('/api/dismiss-rec/' + id, {method:'POST'})
    .then(r => r.json())
    .then(d => {
      if (d.ok) {
        const el = document.getElementById('rec-' + id);
        if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.2s';
                  setTimeout(() => el.remove(), 200); }
      }
    });
}
function restoreDismissed(e) {
  e.preventDefault();
  fetch('/api/restore-dismissed', {method:'POST'})
    .then(r => r.json())
    .then(d => { if (d.ok) location.reload(); });
}
</script>
{% endblock %}
''')

AUTHOR_SIMILAR_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; align-items:baseline; gap:1.5rem; margin-bottom:0.5rem;">
  <h1 class="page-title" style="margin:0; border:none;">Authors like {{ author }}</h1>
  <span id="author-like-status" style="display:flex; gap:0.5rem;">
    <button onclick="setAuthorLike('liked')"
            style="background:{{ '#2a4a2a' if author_status=='liked' else 'var(--bg3)' }};
                   border:1px solid {{ '#4a8a4a' if author_status=='liked' else 'var(--border)' }};
                   color:{{ '#6aba6a' if author_status=='liked' else 'var(--muted)' }};
                   padding:0.25rem 0.7rem; border-radius:4px; cursor:pointer;
                   font-family:inherit; font-size:0.82rem;">
      &#9829; Like this author
    </button>
  </span>
</div>
<p style="color:var(--muted); margin-bottom:1.5rem; font-size:0.88rem;">
  {{ story_count }} stories &nbsp;&middot;&nbsp;
  <a href="/author/{{ author | urlencode }}">View all stories &rarr;</a>
</p>

{% if not index_ready %}
<p style="color:var(--accent2); margin-bottom:1rem;">&#9203; Building index&hellip; refresh in a moment</p>
{% endif %}

<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1rem;">
{% for other, score, profile in similar %}
<div style="background:var(--bg2); border:1px solid var(--border); border-radius:6px; padding:1rem;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.4rem;">
    <a href="/author/{{ other | urlencode }}" style="font-size:1rem; font-weight:500;">{{ other }}</a>
    <span style="font-size:0.75rem; color:var(--muted); font-family:monospace;">
      {{ "%.0f"|format(score*100) }}% match
    </span>
  </div>
  <div style="font-size:0.8rem; color:var(--muted); margin-bottom:0.5rem;">
    {{ profile.story_count }} stories
  </div>
  {% if profile.top_themes %}
  <div style="margin-bottom:0.3rem;">
    {% for t in profile.top_themes %}<span class="tag" style="color:#a0c898;font-size:0.72rem;">{{ t }}</span>{% endfor %}
  </div>
  {% endif %}
  {% if profile.top_mc_types %}
  <div>
    {% for m in profile.top_mc_types %}<span class="tag mc-type" style="font-size:0.72rem;">{{ m }}</span>{% endfor %}
  </div>
  {% endif %}
  <div style="margin-top:0.75rem; display:flex; gap:0.5rem;">
    <a href="/author-similar/{{ other | urlencode }}"
       style="font-size:0.78rem; color:var(--muted);">Authors like {{ other }} &rarr;</a>
  </div>
</div>
{% else %}
<p style="color:var(--muted);">No similar authors found.</p>
{% endfor %}
</div>

<script>
function setAuthorLike(status) {
  fetch('/api/like-author/{{ author | urlencode }}', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({status: status})
  }).then(r => r.json()).then(d => { if (d.ok) location.reload(); });
}
</script>
{% endblock %}
''')

HISTORY_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">&#9654; Reading History</h1>
{% if not entries %}
<p style="color:var(--muted)">No reading history yet. Open any story to start tracking.</p>
{% else %}
<div class="story-grid">
{% for s, info in entries %}
{% set at = s.auto_tags or {} %}
<div class="story-card">
  <div class="story-title">
    <a href="/story/{{ s.id }}{% if info.total > 1 %}?ch={{ info.last_chapter }}{% endif %}">{{ s | dt }}</a>
    {% if info.total > 1 %}
    <span class="pref-badge badge-history">&#9654; Ch {{ info.last_chapter }}/{{ info.total }}</span>
    {% else %}
    <span class="pref-badge badge-history">&#9654; read</span>
    {% endif %}
  </div>
  <div class="story-meta">
    <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author or "Unknown" }}</a></span>
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} chapters</span>{% endif %}
  </div>
  <div>
    {% for cat in s.categories[:6] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}<span class="tag mc-type">{{ mc }}</span>{% endfor %}
  </div>
  {% if s.description %}<div class="story-desc">{{ s.description }}</div>{% endif %}
</div>
{% endfor %}
</div>
{% endif %}
{% endblock %}
''')

WANT_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1.5rem;">
  <h1 class="page-title" style="margin:0;border:none;">&#128278; Want to Read</h1>
  <span style="font-size:0.82rem; color:var(--muted);">{{ stories|length }} stories</span>
</div>
{% if not stories %}
<div style="text-align:center; padding:3rem; color:var(--muted);">
  <p style="font-size:1.1rem; margin-bottom:0.75rem;">No stories saved yet.</p>
  <p>Click &#128278; Want on any story card to save it for later.</p>
  <p style="margin-top:1rem;"><a href="/">Browse stories &rarr;</a></p>
</div>
{% else %}
<div class="story-grid">
{% for s in stories %}
{% set at = s.auto_tags or {} %}
<div class="story-card">
  <div class="story-title">
    <a href="/story/{{ s.id }}">{{ s | dt }}</a>
    <span class="pref-badge badge-wtr">&#128278; want to read</span>
  </div>
  <div class="story-meta">
    <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author or "Unknown" }}</a></span>
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} ch</span>{% endif %}
  </div>
  <div>
    {% for cat in s.categories[:6] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}<span class="tag mc-type">{{ mc }}</span>{% endfor %}
  </div>
  {% if s.description %}<div class="story-desc">{{ s.description }}</div>{% endif %}
  <div style="margin-top:0.4rem;">
    <button onclick="removeWant('{{ s.id }}', this)"
            style="font-size:0.78rem; color:var(--muted); background:none; border:none;
                   cursor:pointer; padding:0;">&#10005; Remove</button>
  </div>
</div>
{% endfor %}
</div>
{% endif %}
<script>
function removeWant(id, btn) {
  fetch('/api/want/' + id, {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({wanted: false})})
  .then(r => r.json()).then(d => {
    if (d.ok && !d.wanted) {
      var card = btn.closest('.story-card');
      if (card) { card.style.opacity='0'; card.style.transition='opacity 0.2s';
                  setTimeout(function(){ card.remove(); }, 200); }
    }
  });
}
</script>
{% endblock %}
''')

LIKED_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1.5rem;">
  <h1 class="page-title" style="margin:0;border:none;">&#9733; Liked Stories</h1>
  <div style="display:flex; gap:1rem; font-size:0.88rem;">
    <a href="/liked/export?fmt=json">Export JSON</a>
    <a href="/liked/export?fmt=csv">Export CSV</a>
    <a href="/liked/export?fmt=txt">Export list</a>
  </div>
</div>
{% if not liked_stories and not liked_authors %}
<div style="text-align:center; padding:3rem; color:var(--muted);">
  <p style="font-size:1.2rem; margin-bottom:0.75rem;">No liked stories yet.</p>
  <p>Open any story and click &#9829; Like.</p>
  <p style="margin-top:1rem;"><a href="/">Browse stories &rarr;</a></p>
</div>
{% else %}
{% if liked_authors %}
<div style="margin-bottom:2rem;">
  <div style="font-size:0.78rem; color:var(--muted); letter-spacing:0.1em;
              text-transform:uppercase; margin-bottom:0.75rem;">Followed Authors</div>
  <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
  {% for author in liked_authors %}
  <span style="background:var(--bg2); border:1px solid var(--border); border-radius:4px;
               padding:0.3rem 0.75rem; display:inline-flex; align-items:center; gap:0.5rem;">
    <a href="/author/{{ author | urlencode }}" style="font-size:0.92rem;">{{ author }}</a>
    <button onclick="unfollowAuthor('{{ author | urlencode }}')"
            style="background:none;border:none;color:var(--muted);cursor:pointer;
                   font-size:0.8rem; padding:0;">&#10005;</button>
  </span>
  {% endfor %}
  </div>
</div>
{% endif %}
{% if liked_stories %}
<div style="font-size:0.78rem; color:var(--muted); letter-spacing:0.1em;
            text-transform:uppercase; margin-bottom:0.75rem;">
  {{ liked_stories|length }} Liked Stories
</div>
<div class="story-grid">
{% for s in liked_stories %}
<div class="story-card liked-card">
  <div class="story-title"><a href="/story/{{ s.id }}">{{ s | dt }}</a></div>
  <div class="story-meta">
    <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author }}</a></span>
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} ch</span>{% endif %}
  </div>
  {% set at = s.auto_tags or {} %}
  <div>
    {% for cat in s.categories[:6] %}<a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>{% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}<span class="tag mc-type">{{ mc }}</span>{% endfor %}
  </div>
  {% if s.description %}<div class="story-desc">{{ s.description }}</div>{% endif %}
  <div style="margin-top:0.4rem;">
    <button onclick="removeLike('{{ s.id }}', this)"
            style="font-size:0.78rem; color:var(--muted); background:none; border:none;
                   cursor:pointer; padding:0;">&#10005; Remove</button>
  </div>
</div>
{% endfor %}
</div>
{% endif %}
{% endif %}
<script>
function removeLike(id, btn) {
  fetch('/api/like/' + id, {method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({status:'none'})
  }).then(r=>r.json()).then(d=>{ if(d.ok) btn.closest('.story-card').remove(); });
}
function unfollowAuthor(author) {
  fetch('/api/like-author/' + author, {method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({status:'none'})
  }).then(r=>r.json()).then(d=>{ if(d.ok) location.reload(); });
}
</script>
{% endblock %}
''')

NEW_STORIES_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1rem;">
  <h1 class="page-title" style="margin:0;border:none;">&#9679; New Stories</h1>
  <span style="font-size:0.82rem; color:var(--muted);">
    {{ new_stories|length }} stories/updates
    {% if last_run %}&middot; Last update: {{ last_run }}{% endif %}
  </span>
</div>
{% if update_runs %}
<div style="background:var(--bg2); border:1px solid var(--border); border-radius:6px;
            padding:0.75rem 1rem; margin-bottom:1.5rem; font-size:0.82rem;">
  <span style="color:var(--muted); margin-right:1rem;">Recent updates:</span>
  {% for run in update_runs|reverse %}
  <span style="margin-right:1.5rem;">
    {{ run.timestamp[:10] }}
    <span style="color:var(--accent2);">+{{ run.stories_added_to_index or run.get("stories_added", 0) }}</span>
    {% if run.get("chapters_updated") %}<span style="color:var(--muted);">&nbsp;+{{ run.chapters_updated }}ch</span>{% endif %}
  </span>
  {% endfor %}
</div>
{% endif %}
{% if not new_stories %}
<p style="color:var(--muted);">
  Run <code>make update</code> to check for new stories.
</p>
{% else %}
<div class="story-grid">
{% for s, badge in new_stories %}
{% set at = s.auto_tags or {} %}
{% set cats = s.categories %}
{% set is_liked_story  = prefs and prefs.story_status(s.id) == 'liked' %}
{% set is_liked_author = prefs and s.author in prefs.liked_authors %}
{% set is_fave = ('md' in cats or 'mc' in cats) and 'mf' in cats %}
{% set visit = prefs.visit_info(s.id) if prefs else none %}
{% if is_fave and is_liked_author %}{% set card_class = "pref-fave pref-author-fave" %}
{% elif is_fave %}{% set card_class = "pref-fave" %}
{% elif is_liked_author %}{% set card_class = "pref-author" %}
{% elif is_liked_story %}{% set card_class = "pref-liked" %}
{% else %}{% set card_class = "" %}{% endif %}
<div class="story-card {{ card_class }}">
  <div class="story-title">
    <a href="/story/{{ s.id }}">{{ s | dt }}</a>
    {% if badge %}<span class="pref-badge" style="background:#1a3a1a; color:#7ecb7e; border:1px solid #2e5a2e;">{{ badge }}</span>{% endif %}
    {% if is_fave and is_liked_author %}<span class="pref-badge badge-fave">&#9733; fave · liked author</span>
    {% elif is_fave %}<span class="pref-badge badge-fave">&#9733; fave type</span>
    {% elif is_liked_author %}<span class="pref-badge badge-author">&#9733; liked author</span>
    {% elif is_liked_story %}<span class="pref-badge badge-liked">&#9829; liked</span>
    {% endif %}
    {% if visit %}
      {% if visit.total > 1 %}
      <span class="pref-badge badge-history">&#9654; Ch {{ visit.last_chapter }}/{{ visit.total }}</span>
      {% else %}
      <span class="pref-badge badge-history">&#9654; read</span>
      {% endif %}
    {% endif %}
    {% if s.source == "wayback" %}<span class="pref-badge" style="background:#2a3a4a;color:#8ab4d4;border:1px solid #4a7a9a;">&#8984; archived</span>{% endif %}
    {% if prefs and prefs.is_wanted(s.id) %}<span class="pref-badge badge-wtr">&#128278; want to read</span>{% endif %}
  </div>
  <div class="story-meta">
    <span>by <a href="/author/{{ s.author | urlencode }}">{{ s.author or "Unknown" }}</a></span>
    <span>{{ "{:,}".format(s.word_count) }} words</span>
    {% if (s.chapter_count | default(0)) > 1 %}<span class="chapters-badge">{{ s.chapter_count }} chapters</span>{% endif %}
    {% if s.added_date %}<span>{{ s.added_date }}</span>{% endif %}
    {% if at.get("length_class") %}<span class="mono">{{ at.length_class }}</span>{% endif %}
    {% if at.get("pov") %}<span class="mono">{{ at.pov }}</span>{% endif %}
  </div>
  <div>
    {% for cat in cats[:6] %}
    <a href="/tag/{{ cat }}" class="tag">{{ cat }}</a>
    {% endfor %}
    {% for mc in visible_tags(at.get("mind_control_type") or [], at)[:2] %}
    <span class="tag mc-type">{{ mc }}</span>
    {% endfor %}
    {% for d in visible_tags(at.get("dominance") or [], at)[:1] %}
    <span class="tag" style="color:#c8a06a">{{ d }}</span>
    {% endfor %}
    {% for p in visible_tags(at.get("pacing") or [], at)[:1] %}
    <span class="tag" style="color:#7a9e7a">{{ p }}</span>
    {% endfor %}
    {% for a in visible_tags(at.get("awareness") or [], at)[:1] %}
    <span class="tag" style="color:#8a9abf">{{ a }}</span>
    {% endfor %}
  </div>
  {% if s.description %}
  <div class="story-desc">{{ s.description }}</div>
  {% endif %}
  <div style="margin-top:0.4rem; display:flex; align-items:center; flex-wrap:wrap; gap:0.25rem;">
    {% if prefs %}
    {% set status = prefs.story_status(s.id) %}
    <button onclick="cardLike(this,'{{ s.id }}','liked')"
            style="background:{{ '#e8f4e8' if status=='liked' else 'transparent' }};
                   border:1px solid {{ '#4a8a4a' if status=='liked' else 'var(--border)' }};
                   color:{{ '#2a5a2a' if status=='liked' else 'var(--muted)' }};
                   padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                   font-size:0.75rem; font-family:inherit;">
      {{ "♥" if status=='liked' else "♡" }} Like
    </button>
    {% if status == 'liked' %}
    <button onclick="cardLike(this,'{{ s.id }}','none')"
            style="background:transparent; border:1px solid var(--border);
                   color:var(--muted); padding:0.15rem 0.6rem; border-radius:3px;
                   cursor:pointer; font-size:0.75rem; font-family:inherit;">
      ✕ Unlike
    </button>
    {% endif %}
    {% endif %}
    {% if prefs %}
    <button class="want-btn" data-wanted="{{ '1' if prefs.is_wanted(s.id) else '0' }}"
            onclick="cardWant(this,'{{ s.id }}')"
            style="background:{{ '#e8f4e8' if prefs.is_wanted(s.id) else 'transparent' }};
                   border:1px solid {{ '#4a7a4a' if prefs.is_wanted(s.id) else 'var(--border)' }};
                   color:{{ '#2a5a2a' if prefs.is_wanted(s.id) else 'var(--muted)' }};
                   padding:0.15rem 0.6rem; border-radius:3px; cursor:pointer;
                   font-size:0.75rem; font-family:inherit;">
      &#128278; {{ "Wanted" if prefs.is_wanted(s.id) else "Want" }}
    </button>
    {% endif %}
    <button class="preview-btn" onclick="togglePreview(this,'{{ s.id }}')">&#9656; Preview</button>
  </div>
  <div class="preview-box" id="preview-{{ s.id }}"></div>
</div>
{% endfor %}
</div>
{% endif %}
{% endblock %}
''')

GENERATE_TMPL = BASE_HTML.replace("{% block content %}{% endblock %}", '''
{% block content %}
<h1 class="page-title">&#9998; Generate a Story</h1>

<!-- LLM Connection Status -->
<div id="llm-status" style="margin-bottom:1.5rem; padding:0.75rem 1rem;
     background:var(--bg2); border:1px solid var(--border); border-radius:6px;
     font-size:0.88rem; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
  <span id="status-dot" style="width:10px;height:10px;border-radius:50%;
        background:#ccc; display:inline-block; flex-shrink:0;"></span>
  <span id="status-text" style="color:var(--muted);">Checking for local LLM...</span>
  <span style="flex:1"></span>
  <select id="endpoint-select" style="background:var(--bg3); border:1px solid var(--border);
          color:var(--text); padding:0.3rem 0.6rem; border-radius:4px; font-family:inherit;
          font-size:0.82rem;" onchange="checkConnection()">
    <option value="lmstudio">LM Studio (localhost:1234)</option>
    <option value="ollama">Ollama (localhost:11434)</option>
    <option value="custom">Custom endpoint</option>
  </select>
  <input id="custom-url" type="text" placeholder="http://localhost:8080/v1"
         style="display:none; background:var(--bg3); border:1px solid var(--border);
                color:var(--text); padding:0.3rem 0.6rem; border-radius:4px;
                font-family:inherit; font-size:0.82rem; width:220px;">
  <input id="api-key" type="password" placeholder="API key (optional)"
         style="background:var(--bg3); border:1px solid var(--border);
                color:var(--text); padding:0.3rem 0.6rem; border-radius:4px;
                font-family:inherit; font-size:0.82rem; width:160px;">
  <select id="model-select" style="background:var(--bg3); border:1px solid var(--border);
          color:var(--text); padding:0.3rem 0.6rem; border-radius:4px; font-family:inherit;
          font-size:0.82rem; min-width:180px;">
    <option value="auto">Auto-detect model</option>
  </select>
</div>

<!-- Two-column layout: controls left, output right -->
<div style="display:grid; grid-template-columns:340px 1fr; gap:2rem; align-items:start;">

<!-- ── Left: controls ── -->
<div>
  <div style="background:var(--bg2); border:1px solid var(--border); border-radius:8px;
              padding:1.25rem;">

    <div style="margin-bottom:1rem;">
      <label style="font-size:0.78rem; color:var(--muted); letter-spacing:0.08em;
                    text-transform:uppercase; display:block; margin-bottom:0.4rem;">
        What do you want?
      </label>
      <textarea id="request-text" rows="4"
                placeholder="e.g. A woman visits her new therapist who turns out to have unusual methods of relaxation..."
                style="width:100%; background:var(--bg3); border:1px solid var(--border);
                       color:var(--text); padding:0.5rem 0.75rem; border-radius:4px;
                       font-family:inherit; font-size:0.95rem; resize:vertical;
                       line-height:1.5;"></textarea>
    </div>

    <div style="margin-bottom:0.8rem;">
      <label style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                    letter-spacing:0.08em; display:block; margin-bottom:0.4rem;">
        Mode
      </label>
      <div style="display:flex; gap:0.5rem;">
        <button class="mode-btn active" data-mode="inspired" onclick="setMode(this)"
                style="flex:1; padding:0.4rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.82rem;">
          &#10024; Inspired by
        </button>
        <button class="mode-btn" data-mode="remix" onclick="setMode(this)"
                style="flex:1; padding:0.4rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.82rem;">
          &#8635; Remix
        </button>
        <button class="mode-btn" data-mode="continue" onclick="setMode(this)"
                style="flex:1; padding:0.4rem; border-radius:4px; cursor:pointer;
                       font-family:inherit; font-size:0.82rem;">
          &#9654; Continue
        </button>
      </div>
    </div>

    <!-- Tag filters -->
    {% for label, name, options in [
      ("MC method", "mc_type", mc_types),
      ("Setting", "setting", settings),
      ("Tone", "tone", tones),
      ("Dominance", "dominance", dominances),
      ("Pacing", "pacing", pacings),
      ("Victim awareness", "awareness", awareness_opts),
    ] %}
    <div style="margin-bottom:0.7rem;">
      <label style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                    letter-spacing:0.08em; display:block; margin-bottom:0.3rem;">{{ label }}</label>
      <select name="{{ name }}" id="tag-{{ name }}"
              style="width:100%; background:var(--bg3); border:1px solid var(--border);
                     color:var(--text); padding:0.35rem 0.6rem; border-radius:4px;
                     font-family:inherit; font-size:0.88rem;">
        <option value="">Any</option>
        {% for o in options %}<option value="{{ o }}">{{ o }}</option>{% endfor %}
      </select>
    </div>
    {% endfor %}

    <!-- Theme multi-select -->
    <div style="margin-bottom:0.7rem;">
      <label style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                    letter-spacing:0.08em; display:block; margin-bottom:0.3rem;">
        Themes (pick up to 3)
      </label>
      <div id="theme-pills" style="display:flex; flex-wrap:wrap; gap:0.3rem;">
        {% for t in themes[:16] %}
        <button onclick="toggleTheme(this)" data-theme="{{ t }}"
                style="background:var(--bg3); border:1px solid var(--border);
                       color:var(--muted); padding:0.15rem 0.5rem; border-radius:3px;
                       font-size:0.75rem; cursor:pointer; font-family:inherit;">{{ t }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- Length -->
    <div style="margin-bottom:1rem;">
      <label style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                    letter-spacing:0.08em; display:block; margin-bottom:0.3rem;">Length</label>
      <select id="tag-length"
              style="width:100%; background:var(--bg3); border:1px solid var(--border);
                     color:var(--text); padding:0.35rem 0.6rem; border-radius:4px;
                     font-family:inherit; font-size:0.88rem;">
        <option value="short story">Short story (2k–6k words)</option>
        <option value="flash">Flash (&lt;1k words)</option>
        <option value="novelette">Novelette (8k–15k words)</option>
      </select>
    </div>

    <!-- Temperature -->
    <div style="margin-bottom:1rem;">
      <label style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                    letter-spacing:0.08em; display:flex; justify-content:space-between;
                    margin-bottom:0.3rem;">
        <span>Creativity</span>
        <span id="temp-label" style="font-family:monospace;">0.85</span>
      </label>
      <input type="range" id="temperature" min="0.5" max="1.3" step="0.05" value="0.85"
             style="width:100%;" oninput="document.getElementById('temp-label').textContent=this.value">
      <div style="display:flex; justify-content:space-between; font-size:0.72rem;
                  color:var(--muted); margin-top:0.2rem;">
        <span>Focused</span><span>Balanced</span><span>Wild</span>
      </div>
    </div>

    <button id="generate-btn" onclick="generate()"
            style="width:100%; background:#3d2b1a; color:#e8c99a; border:none;
                   padding:0.65rem; border-radius:6px; font-family:inherit; font-size:1rem;
                   cursor:pointer; font-weight:500; letter-spacing:0.02em;">
      &#9998; Generate Story
    </button>
    <button id="stop-btn" onclick="stopGeneration()" style="display:none; width:100%;
            background:#8b2a2a; color:#fff; border:none; padding:0.5rem; border-radius:6px;
            font-family:inherit; font-size:0.9rem; cursor:pointer; margin-top:0.4rem;">
      &#9632; Stop
    </button>
  </div>

  <!-- Retrieved examples -->
  <div id="examples-panel" style="margin-top:1rem; display:none;">
    <div style="font-size:0.78rem; color:var(--muted); text-transform:uppercase;
                letter-spacing:0.08em; margin-bottom:0.5rem;">Retrieved examples</div>
    <div id="examples-list"></div>
  </div>
</div>

<!-- ── Right: output ── -->
<div>
  <div id="output-panel" style="display:none;">
    <div style="display:flex; justify-content:space-between; align-items:center;
                margin-bottom:0.75rem;">
      <div id="output-title" style="font-size:1.1rem; font-weight:500;
                                    color:var(--accent2);"></div>
      <div style="display:flex; gap:0.75rem; font-size:0.82rem;">
        <button onclick="copyOutput()"
                style="background:var(--bg2); border:1px solid var(--border); color:var(--text);
                       padding:0.3rem 0.7rem; border-radius:4px; cursor:pointer;
                       font-family:inherit;">&#128203; Copy</button>
        <button onclick="saveOutput()"
                style="background:var(--bg2); border:1px solid var(--border); color:var(--text);
                       padding:0.3rem 0.7rem; border-radius:4px; cursor:pointer;
                       font-family:inherit;">&#128190; Save .txt</button>
        <button onclick="regenerate()"
                style="background:var(--bg2); border:1px solid var(--border); color:var(--text);
                       padding:0.3rem 0.7rem; border-radius:4px; cursor:pointer;
                       font-family:inherit;">&#8635; Regenerate</button>
      </div>
    </div>
    <div id="output-meta" style="font-size:0.82rem; color:var(--muted);
                                 margin-bottom:1rem;"></div>
    <div id="output-text"
         style="font-family:'Crimson Pro',Georgia,serif; font-size:1.1rem;
                line-height:1.95; max-width:780px; white-space:pre-wrap;
                border-top:1px solid var(--border); padding-top:1.25rem;"></div>
    <div id="word-count" style="font-size:0.78rem; color:var(--muted);
                                margin-top:1rem; text-align:right;"></div>
  </div>
  <div id="placeholder" style="color:var(--muted); padding:4rem 2rem; text-align:center;
                                font-style:italic; font-size:1.05rem;">
    Describe a story and click Generate &rarr;
  </div>
  <div id="error-box" style="display:none; background:#f4e8e8; border:1px solid #8b2a2a;
       border-radius:6px; padding:1rem; color:#5a1a1a; font-size:0.9rem;
       margin-top:1rem;"></div>
</div>
</div>

<style>
.mode-btn { background:var(--bg3); border:1px solid var(--border); color:var(--muted); }
.mode-btn.active { background:#3d2b1a; border-color:#3d2b1a; color:#e8c99a; }
#request-text, #custom-url, #api-key, #model-select, #endpoint-select,
select[name], #tag-length, #tag-mc_type, #tag-setting, #tag-tone,
#tag-dominance, #tag-pacing {
  color: var(--text) !important;
}
</style>

<script>
let currentMode = 'inspired';
let controller  = null;
let lastRequest = null;

// ── Connection ──
const ENDPOINTS = {
  lmstudio: 'http://localhost:1234/v1',
  ollama:   'http://localhost:11434/v1',
};

document.getElementById('endpoint-select').addEventListener('change', function() {
  document.getElementById('custom-url').style.display =
    this.value === 'custom' ? 'inline-block' : 'none';
  checkConnection();
});

async function checkConnection() {
  const dot  = document.getElementById('status-dot');
  const text = document.getElementById('status-text');
  dot.style.background = '#f0a030';
  text.textContent = 'Connecting...';

  const ep  = document.getElementById('endpoint-select').value;
  const url = ep === 'custom'
    ? document.getElementById('custom-url').value || 'http://localhost:8080/v1'
    : ENDPOINTS[ep] || ENDPOINTS.lmstudio;
  const key = document.getElementById('api-key').value || 'none';

  try {
    const r = await fetch('/api/llm/models', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({url, key})
    });
    const d = await r.json();
    if (d.models && d.models.length > 0) {
      dot.style.background  = '#4a8a4a';
      text.textContent = `Connected — ${d.models.length} model(s) available`;
      const sel = document.getElementById('model-select');
      sel.innerHTML = d.models.map(m =>
        `<option value="${m}">${m}</option>`).join('');
    } else {
      dot.style.background = '#8b2a2a';
      text.textContent = 'No models found — is LM Studio running?';
    }
  } catch(e) {
    dot.style.background = '#8b2a2a';
    text.textContent = 'Could not connect — start LM Studio or Ollama first';
  }
}

// ── Mode ──
function setMode(btn) {
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentMode = btn.dataset.mode;
}

// ── Theme pills ──
function toggleTheme(btn) {
  const active = document.querySelectorAll('#theme-pills button.active');
  if (!btn.classList.contains('active') && active.length >= 3) return;
  btn.classList.toggle('active');
  btn.style.background = btn.classList.contains('active') ? '#e8f0e8' : 'var(--bg3)';
  btn.style.borderColor = btn.classList.contains('active') ? '#4a7a4a' : 'var(--border)';
  btn.style.color = btn.classList.contains('active') ? '#2a5a2a' : 'var(--muted)';
}

function getSelectedThemes() {
  return Array.from(document.querySelectorAll('#theme-pills button.active'))
    .map(b => b.dataset.theme);
}

// ── Generate ──
async function generate() {
  const requestText = document.getElementById('request-text').value.trim();
  if (!requestText && currentMode !== 'continue') {
    alert('Please describe what you want to generate.');
    return;
  }

  const ep  = document.getElementById('endpoint-select').value;
  const url = ep === 'custom'
    ? document.getElementById('custom-url').value || 'http://localhost:8080/v1'
    : ENDPOINTS[ep] || ENDPOINTS.lmstudio;
  const key   = document.getElementById('api-key').value || 'none';
  const model = document.getElementById('model-select').value || 'auto';
  const temp  = parseFloat(document.getElementById('temperature').value);
  const length = document.getElementById('tag-length').value;

  const tags = {
    mc_type:   document.getElementById('tag-mc_type').value,
    setting:   document.getElementById('tag-setting').value,
    tone:      document.getElementById('tag-tone').value,
    dominance: document.getElementById('tag-dominance').value,
    pacing:    document.getElementById('tag-pacing').value,
    themes:    getSelectedThemes(),
    length:    length,
  };

  lastRequest = {requestText, url, key, model, temp, tags, mode: currentMode};

  document.getElementById('generate-btn').style.display = 'none';
  document.getElementById('stop-btn').style.display     = 'block';
  document.getElementById('placeholder').style.display  = 'none';
  document.getElementById('error-box').style.display    = 'none';
  document.getElementById('output-panel').style.display = 'block';
  document.getElementById('output-title').textContent   = 'Retrieving examples...';
  document.getElementById('output-text').textContent    = '';
  document.getElementById('output-meta').textContent    = '';
  document.getElementById('word-count').textContent     = '';

  controller = new AbortController();

  try {
    // Step 1: retrieve similar stories (RAG)
    const retrieveRes = await fetch('/api/generate/retrieve', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({query: requestText, tags})
    });
    const retrieved = await retrieveRes.json();
    showExamples(retrieved.examples || []);

    document.getElementById('output-title').textContent = 'Generating...';
    document.getElementById('output-meta').textContent  =
      `Model: ${model} · Temp: ${temp} · Mode: ${currentMode}`;

    // Step 2: stream generation
    const genRes = await fetch('/api/generate/stream', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      signal: controller.signal,
      body: JSON.stringify({
        request_text: requestText,
        examples:     retrieved.examples || [],
        tags, mode: currentMode, url, key, model, temperature: temp,
        max_tokens: {{ max_tokens }}
      })
    });

    if (!genRes.ok) {
      const err = await genRes.json();
      throw new Error(err.error || 'Generation failed');
    }

    const reader = genRes.body.getReader();
    const decoder = new TextDecoder();
    let fullText = '';
    const outputEl = document.getElementById('output-text');

    while (true) {
      const {done, value} = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, {stream: true});
      fullText += chunk;
      outputEl.textContent = fullText;
      const wc = fullText.split(' ').filter(function(w){return w.length>0;}).length;
      document.getElementById('word-count').textContent = `${wc.toLocaleString()} words`;
    }

    document.getElementById('output-title').textContent = 'Generated Story';

  } catch(e) {
    if (e.name !== 'AbortError') {
      document.getElementById('error-box').style.display = 'block';
      document.getElementById('error-box').textContent   = `Error: ${e.message}`;
      document.getElementById('output-panel').style.display = 'none';
      document.getElementById('placeholder').style.display  = 'block';
    }
  } finally {
    document.getElementById('generate-btn').style.display = 'block';
    document.getElementById('stop-btn').style.display     = 'none';
  }
}

function stopGeneration() {
  if (controller) { controller.abort(); controller = null; }
}

function regenerate() {
  if (lastRequest) generate();
}

function showExamples(examples) {
  const panel = document.getElementById('examples-panel');
  const list  = document.getElementById('examples-list');
  if (!examples.length) { panel.style.display = 'none'; return; }
  panel.style.display = 'block';
  list.innerHTML = examples.map(e =>
    `<div style="font-size:0.82rem; padding:0.4rem 0; border-bottom:1px solid var(--border);">
      <a href="/story/${e.id}" target="_blank" style="font-weight:500;">${e.title||e.id}</a>
      <span style="color:var(--muted); margin-left:0.5rem;">${e.author||''}</span>
      <span style="color:var(--muted); margin-left:0.5rem; float:right;">${(e.score*100).toFixed(0)}% match</span>
    </div>`
  ).join('');
}

function copyOutput() {
  navigator.clipboard.writeText(document.getElementById('output-text').textContent);
}

function saveOutput() {
  const text = document.getElementById('output-text').textContent;
  const blob = new Blob([text], {type:'text/plain'});
  const a    = document.createElement('a');
  a.href     = URL.createObjectURL(blob);
  a.download = 'generated_story.txt';
  a.click();
}

// Check connection on load
window.addEventListener('load', checkConnection);
</script>
{% endblock %}
''')

# ── Routes ────────────────────────────────────────────────────────────────────

from tagger import (SETTING_RULES, THEME_RULES, TONE_RULES,
                    MIND_CONTROL_TYPE_RULES, DOMINANCE_RULES, PACING_RULES,
                    AWARENESS_RULES)
from svengali import SV_SEXUAL_ACTS, SV_FETISH, SV_RELATIONSHIP

MC_TYPES      = [r[0] for r in MIND_CONTROL_TYPE_RULES]
SETTINGS      = [r[0] for r in SETTING_RULES]
THEMES        = [r[0] for r in THEME_RULES]
TONES         = [r[0] for r in TONE_RULES]

# gentle + brutal excluded: feature-only tags (P10-27% eval precision).
# Still written to auto_tags for recommendations, not useful as search filters.
DOMINANCES    = [r[0] for r in DOMINANCE_RULES
                 if r[0] not in ("gentle", "brutal")]

# rapid + epic added: generated by infer_pacing_from_structure, not in PACING_RULES.
PACINGS       = [r[0] for r in PACING_RULES] + ["rapid", "epic"]

# consensual excluded: disabled (P3% eval, essentially noise).
# denial excluded: feature-only (P27% eval), kept in auto_tags for recs only.
AWARENESS     = [r[0] for r in AWARENESS_RULES
                 if r[0] not in ("consensual", "denial")]
LENGTHS       = ["flash", "short story", "novelette", "novella", "novel"]
SEXUAL_ACTS   = sorted(set(SV_SEXUAL_ACTS.values()))
FETISH_TAGS   = sorted(set(SV_FETISH.values()))
RELATIONSHIPS = sorted(set(SV_RELATIONSHIP.values()))

def filter_params():
    """Current filter params as URL query string (without page)."""
    args = request.args.to_dict(flat=False)
    args.pop("page", None)
    parts = []
    for k, vals in args.items():
        for v in vals:
            if v:
                parts.append(f"{k}={v}")
    return "&".join(parts)

@app.route("/")
def index():
    q            = request.args.get("q", "")
    cat          = request.args.get("cat", "")
    mc_type      = request.args.get("mc_type", "")
    setting      = request.args.get("setting", "")
    themes       = request.args.getlist("theme")
    theme_logic  = request.args.get("theme_logic", "all")
    tone         = request.args.get("tone", "")
    dominance    = request.args.get("dominance", "")
    pacing       = request.args.get("pacing", "")
    awareness    = request.args.get("awareness", "")
    sexual_acts       = request.args.getlist("sexual_act")
    sexual_act_logic  = request.args.get("sexual_act_logic", "any")
    fetish_tags       = request.args.getlist("fetish_tag")
    fetish_tag_logic  = request.args.get("fetish_tag_logic", "any")
    relationship = request.args.get("relationship", "")
    length_class = request.args.get("length", "")
    date_from    = request.args.get("date_from", "")
    date_to      = request.args.get("date_to", "")
    sort         = request.args.get("sort", "relevance")
    page         = max(1, int(request.args.get("page", 1)))
    soft         = request.args.get("soft", "") == "1"
    archived     = request.args.get("archived", "") == "1"
    liked_filter = request.args.get("liked_filter", "") == "1"
    search_mode  = request.args.get("search_mode", "fuzzy")
    exclude_cat  = request.args.get("exclude_cat", "")
    per_page     = 30

    cats      = [c.strip() for c in cat.split() if c.strip()]
    excl_cats = [c.strip() for c in exclude_cat.split() if c.strip()]

    # Natural language query: detect tag phrases in the raw query string
    nlq_clean, nlq_detected = parse_natural_query(q) if q else ("", {})
    nlq_url = nlq_apply_url(nlq_clean, nlq_detected) if nlq_detected else ""

    results, total = search_stories(
        query=q, categories=cats, mc_type=mc_type, setting=setting,
        themes=themes, theme_logic=theme_logic, tone=tone, dominance=dominance, pacing=pacing,
        awareness=awareness, length_class=length_class,
        sexual_acts=sexual_acts, sexual_act_logic=sexual_act_logic,
        fetish_tags=fetish_tags, fetish_tag_logic=fetish_tag_logic,
        relationship=relationship,
        date_from=date_from, date_to=date_to,
        sort=sort, page=page, per_page=per_page, soft=soft,
        archived=archived, search_mode=search_mode, liked_filter=liked_filter,
        exclude_cats=excl_cats
    )
    total_pages = max(1, (total + per_page - 1) // per_page)

    tmpl = app.jinja_env.from_string(INDEX_TMPL)
    return tmpl.render(
        results=results, total=total, page=page, total_pages=total_pages,
        q=q, cat=cat, mc_type=mc_type, setting=setting, selected_themes=themes, theme_logic=theme_logic, tone=tone,
        dominance=dominance, pacing=pacing, awareness=awareness,
        selected_sexual_acts=sexual_acts, sexual_act_logic=sexual_act_logic,
        selected_fetish_tags=fetish_tags, fetish_tag_logic=fetish_tag_logic,
        relationship=relationship,
        length_class=length_class, date_from=date_from, date_to=date_to,
        sort=sort, soft=soft, archived=archived, liked_filter=liked_filter, search_mode=search_mode,
        exclude_cat=exclude_cat,
        params=filter_params(),
        nlq_detected=nlq_detected, nlq_url=nlq_url,
        mc_types=MC_TYPES, settings=SETTINGS, themes=THEMES, tones=TONES,
        dominances=DOMINANCES, pacings=PACINGS, awareness_opts=AWARENESS,
        sexual_acts=SEXUAL_ACTS, fetish_tags=FETISH_TAGS, relationships=RELATIONSHIPS,
        lengths=LENGTHS, prefs=_prefs, request=request
    )

@app.route("/search")
def search():
    return index()

@app.route("/story/<story_id>")
def story(story_id):
    s = _data.get("by_id", {}).get(story_id)
    if not s:
        abort(404)
    # Fetch full_text on demand (not stored in slim in-memory index)
    import html as _html
    full_text = s.get("full_text") or get_story_text(story_id)
    is_html = full_text.lstrip().startswith("<") or "<!-- BREAK -->" in full_text
    if is_html:
        raw_chapters = re.split(r"\n<!--\s*BREAK\s*-->\n", full_text)
        chapter_chunks = [(i + 1, ch.strip()) for i, ch in enumerate(raw_chapters)]
    else:
        raw_chapters = re.split(r"\n\s*\*\s*\*\s*\*\s*\n", full_text)
        chapter_chunks = []
        for i, ch in enumerate(raw_chapters, 1):
            paras = [p.strip() for p in ch.split("\n\n") if p.strip()]
            chapter_chunks.append((i, "\n".join(f"<p>{_html.escape(p)}</p>" for p in paras)))
    chapter_count = len(chapter_chunks)
    chapters = [(i, f"Ch. {i}") for i in range(1, chapter_count + 1)]
    story_status = _prefs.story_status(story_id) if _prefs else "none"
    try:
        current_ch = max(1, min(chapter_count, int(request.args.get("ch", 1))))
    except (ValueError, TypeError):
        current_ch = 1
    # Quick similar stories (top 4, only if index is ready)
    similar = []
    if _rec and _engine._loaded:
        similar = _rec.similar_to_story(story_id, n=4)
    tmpl = app.jinja_env.from_string(STORY_TMPL)
    return tmpl.render(story=s, chapters=chapters, chapter_chunks=chapter_chunks,
                       current_ch=current_ch, story_status=story_status,
                       similar=similar, prefs=_prefs, request=request)

@app.route("/author/<author_name>")
def author(author_name):
    author_stories = _data.get("by_author", {}).get(author_name, [])
    author_stories = [s for s in author_stories if not s.get("fetch_error")]
    author_stories.sort(key=lambda s: dt(s).lower())
    author_status = _prefs.author_status(author_name) if _prefs else "none"
    tmpl = app.jinja_env.from_string(AUTHOR_TMPL)
    return tmpl.render(author=author_name, stories=author_stories,
                       author_status=author_status, prefs=_prefs, request=request)

