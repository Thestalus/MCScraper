#!/usr/bin/env python3
"""
browser.py — local web interface for browsing your mcstories dataset

Features:
  - Full-text search across titles, authors, descriptions, and story text
  - Filter by category tags, MC type, setting, theme, tone, length, POV
  - Sort by title, author, word count, date added
  - Story reader with chapter navigation
  - Author pages
  - Tag/category pages
  - Random story
  - Dataset statistics dashboard

Usage:
  .venv/bin/python3 browser.py
  .venv/bin/python3 browser.py --index ./output/stories_index.json --port 5003

Then open:  http://localhost:5003
"""

import json
import os
import re
import random
import sqlite3
import argparse
import threading
from pathlib import Path
from functools import lru_cache
from typing import Optional
from flask import Flask, render_template_string, request, jsonify, redirect, url_for, abort
from recommender import EmbeddingEngine, PreferenceStore, RecommendationEngine
from story_bible import (list_bibles, load_bible, save_bible, delete_bible,
                         empty_bible, empty_character, bible_to_system_prompt,
                         next_chapter_prompt, auto_summarise_prompt,
                         extract_threads_prompt)
from search import parse_natural_query, nlq_apply_url, pref_boost_score, tag_coverage_stats

app = Flask(__name__)

# ── Data loading ──────────────────────────────────────────────────────────────

INDEX_PATH  = "./output/stories_index.json"
PREFS_PATH  = "./output/preferences.json"
CACHE_PATH  = "./output/recs_cache.json"
OUTPUT_DIR  = "./output"
_data: dict = {}
_engine     = EmbeddingEngine()
_embeddings_built = False
_prefs: Optional[PreferenceStore]       = None
_rec:   Optional[RecommendationEngine]  = None
_recs_cache: dict = {}
_search_conn: Optional[sqlite3.Connection] = None   # FTS search DB connection
_tag_profile_cache: dict = {}        # cached {dim: {tag: weight}} for pref boost
_tag_profile_nlikes: int = -1        # liked count when cache was built


def _open_search_db():
    """Open output/search.db if it exists (and is not stale). Called from load_data()."""
    global _search_conn
    index_path = _data.get("_index_path", INDEX_PATH)
    db_path    = str(Path(index_path).parent / "search.db")
    if not os.path.exists(db_path):
        return
    # Stale check — if index is newer, the DB needs a rebuild
    if os.path.getmtime(db_path) < os.path.getmtime(index_path):
        print("search.db is stale — run: make build-search-db")
        print("  (falling back to in-memory search until rebuilt)")
        return
    try:
        conn = sqlite3.connect(db_path, check_same_thread=False)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA query_only=1")
        count = conn.execute("SELECT COUNT(*) FROM stories").fetchone()[0]
        _search_conn = conn
        print(f"FTS search DB ready ({count:,} stories) — full-text search enabled")
        # Warm up the FTS index in the background so the first user search is fast.
        # (The 1.6 GB FTS B-tree is cold on first access; this pre-reads it.)
        def _warmup():
            try:
                conn.execute(
                    "SELECT story_id FROM stories_fts WHERE stories_fts MATCH '\"the\"' LIMIT 1"
                ).fetchall()
                print("FTS index warm")
            except Exception:
                pass
        threading.Thread(target=_warmup, daemon=True).start()
    except Exception as e:
        print(f"Could not open search.db: {e} — falling back to in-memory search")


def load_recs_cache() -> bool:
    """Load pre-calculated recommendations cache if it exists and is fresh."""
    global _recs_cache
    cache = Path(CACHE_PATH)
    if not cache.exists():
        return False
    index_mtime = Path(INDEX_PATH).stat().st_mtime if Path(INDEX_PATH).exists() else 0
    prefs_mtime = Path(PREFS_PATH).stat().st_mtime if Path(PREFS_PATH).exists() else 0
    try:
        data = json.loads(cache.read_text(encoding="utf-8"))
        if data.get("index_mtime", 0) < index_mtime:
            print("Recs cache is stale (index updated) — run: make precalc-recs")
            return False
        if data.get("prefs_mtime", 0) < prefs_mtime:
            print("Recs cache is stale (preferences updated) — run: make precalc-recs")
            return False
        _recs_cache = data
        print(f"Loaded recs cache: {data.get('story_count', 0)} stories, "
              f"{len(data.get('personalised', []))} personalised recs")
        return True
    except Exception as e:
        print(f"Could not load recs cache: {e}")
        return False

def _load_from_sqlite(db_path: str) -> tuple[list, dict]:
    """Load slim story metadata from stories_meta.db. Returns (stories_slim, top_meta)."""
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    rows = conn.execute("SELECT * FROM stories").fetchall()
    meta_rows = conn.execute("SELECT key, value FROM meta").fetchall()
    conn.close()

    top_meta = {r["key"]: r["value"] for r in meta_rows}
    stories_slim = []
    for row in rows:
        s = dict(row)
        s["categories"] = json.loads(s["categories"] or "[]")
        s["auto_tags"]  = json.loads(s["auto_tags"]  or "{}")
        s["_has_text"]  = bool(s.pop("has_text", 0))
        stories_slim.append(s)
    return stories_slim, top_meta


def load_data():
    global _data
    p         = Path(INDEX_PATH)
    db_path   = str(Path(INDEX_PATH).parent / "stories_meta.db")
    use_sqlite = Path(db_path).exists()

    if not use_sqlite and not p.exists():
        _data = {"stories": [], "total_stories": 0}
        return

    if use_sqlite:
        # Fast path: load from SQLite (~1s, ~50MB RAM vs ~8s, ~500MB for JSON)
        import time
        t0 = time.time()
        stories_slim, top_meta = _load_from_sqlite(db_path)
        print(f"Loaded {len(stories_slim):,} stories from SQLite in {time.time()-t0:.1f}s")
        _data = top_meta
        _data["_index_path"] = str(p)   # scraper still writes JSON; keep path for text fallback
    else:
        # Fallback: load from JSON (slow but always available)
        print("stories_meta.db not found — loading from JSON (run make build-stories-db to speed this up)")
        with open(p, encoding="utf-8") as f:
            raw = json.load(f)
        stories_slim = []
        for s in raw.get("stories", []):
            slim = {k: v for k, v in s.items() if k != "full_text"}
            slim["_has_text"] = bool(s.get("full_text"))
            stories_slim.append(slim)
        _data = {k: v for k, v in raw.items() if k != "stories"}
        _data["_index_path"] = str(p)
        print(f"Loaded {len(stories_slim):,} stories from JSON (slim)")

    _data["stories"]   = stories_slim
    _data["by_id"]     = {s["id"]: s for s in stories_slim}
    _data["by_author"] = {}
    for s in stories_slim:
        a = s.get("author", "Unknown")
        _data["by_author"].setdefault(a, []).append(s)

    import gc; gc.collect()

    # Init preference store and recommendation engine
    global _prefs, _rec
    _prefs = PreferenceStore(Path(PREFS_PATH))
    _rec   = RecommendationEngine(_engine, _prefs, stories_slim)

    # Build full-text SQLite cache in background (instant on subsequent runs)
    threading.Thread(target=build_text_cache, daemon=True).start()

    # Open FTS search DB (synchronous — just opens the file, very fast)
    _open_search_db()

    # Try loading pre-calculated cache; only build embeddings if cache is missing/stale
    cache_loaded = load_recs_cache()
    if not cache_loaded:
        _emb_cache = Path(OUTPUT_DIR) / "recs_embeddings.npz"
        threading.Thread(target=lambda: _engine.build_index(stories_slim, cache_path=_emb_cache),
                         daemon=True).start()


def _text_db_path() -> str:
    index_path = _data.get("_index_path", INDEX_PATH)
    return str(Path(index_path).parent / "full_text_cache.db")

_text_conn = None  # persistent connection — avoids reopening on every story request

def _get_text_conn():
    global _text_conn
    if _text_conn is not None:
        return _text_conn
    db_path = _text_db_path()
    if os.path.exists(db_path):
        _text_conn = sqlite3.connect(db_path, check_same_thread=False)
        _text_conn.execute("PRAGMA journal_mode=WAL")
    return _text_conn

def build_text_cache():
    """Build SQLite cache of id→full_text in a background thread (fast after first run)."""
    index_path = _data.get("_index_path", INDEX_PATH)
    db_path    = _text_db_path()
    # Skip if cache is newer than index AND has the same story count
    if os.path.exists(db_path) and os.path.getmtime(db_path) >= os.path.getmtime(index_path):
        try:
            cache_conn  = sqlite3.connect(db_path)
            cached_count = cache_conn.execute("SELECT COUNT(*) FROM texts").fetchone()[0]
            cache_conn.close()
            index_count = len([s for s in _data.get("stories", []) if s.get("_has_text")])
            if cached_count >= index_count:
                print(f"Full-text cache up to date ({db_path})")
                return
            print(f"Full-text cache has {cached_count} stories but index has {index_count} — rebuilding…")
        except Exception:
            pass
    print("Building full-text SQLite cache (first run — takes ~1 min)…")
    conn = sqlite3.connect(db_path)
    conn.execute("CREATE TABLE IF NOT EXISTS texts (id TEXT PRIMARY KEY, full_text TEXT)")
    conn.execute("DELETE FROM texts")
    count = 0
    try:
        import ijson
        with open(index_path, "rb") as f:
            for s in ijson.items(f, "stories.item"):
                ft = s.get("full_text")
                if ft:
                    conn.execute("INSERT OR REPLACE INTO texts VALUES (?,?)", (s["id"], ft))
                    count += 1
    except ImportError:
        with open(index_path, encoding="utf-8") as f:
            data = json.load(f)
        for s in data.get("stories", []):
            ft = s.get("full_text")
            if ft:
                conn.execute("INSERT OR REPLACE INTO texts VALUES (?,?)", (s["id"], ft))
                count += 1
    conn.commit()
    conn.close()
    global _text_conn
    _text_conn = None  # force reconnect so next request picks up the new cache
    print(f"Full-text cache built: {count} stories → {db_path}")

def get_story_text(story_id: str) -> str:
    """Fetch full_text for a story — O(1) via persistent SQLite connection."""
    conn = _get_text_conn()
    if conn is not None:
        try:
            row = conn.execute("SELECT full_text FROM texts WHERE id=?",
                               (story_id,)).fetchone()
            if row:
                return row[0]
            # Story not in cache (e.g. imported after last cache build) — fall through
        except Exception:
            pass
    # Fallback: stream index (slow — cache not built yet or story missing from cache)
    index_path = _data.get("_index_path", INDEX_PATH)
    try:
        import ijson
        with open(index_path, "rb") as f:
            for s in ijson.items(f, "stories.item"):
                if s.get("id") == story_id:
                    return s.get("full_text", "")
    except ImportError:
        with open(index_path, encoding="utf-8") as f:
            data = json.load(f)
        for s in data.get("stories", []):
            if s.get("id") == story_id:
                return s.get("full_text", "")
    return ""

def slug_to_title(slug: str) -> str:
    """Convert CamelCase/PascalCase slug to spaced title."""
    if not slug:
        return slug
    spaced = re.sub(r'([a-z0-9])([A-Z])', r'\1 \2', slug)
    spaced = re.sub(r'([A-Z]+)([A-Z][a-z])', r'\1 \2', spaced)
    return spaced

def dt(story) -> str:
    """
    Display title for a story dict or string.
    Handles all cases:
      - story has a real title with spaces → use it
      - story title looks like a slug (no spaces) → run slug_to_title on it
      - story has no title → derive from id
    Works with both dicts and strings.
    """
    if isinstance(story, str):
        # Called with just a string (slug or title)
        if not story:
            return ""
        if " " in story or len(story) <= 4:
            return story
        return slug_to_title(story)
    # Dict
    title = story.get("title") or ""
    sid   = story.get("id") or ""
    if not title:
        return slug_to_title(sid) if sid else ""
    # If title has spaces or is very short (abbreviation), use as-is
    if " " in title or len(title) <= 4:
        return title
    # Title exists but no spaces — it's probably a slug stored as title
    return slug_to_title(title)

# Register Jinja filters — must be after function definitions
import urllib.parse as _up
app.jinja_env.filters["urlencode"]     = _up.quote
app.jinja_env.filters["slug_to_title"] = slug_to_title
app.jinja_env.filters["dt"]            = dt  # display title filter

# ── Tag quality filtering ──────────────────────────────────────────────────────
# Tags where the SetFit classifier is unreliable — only display when Svengali
# community data also backs them (i.e. 'svengali' in _tag_sources[tag]).
# Tags not in this set pass through unconditionally.
LOW_QUALITY_SETFIT_TAGS = frozenset({
    # Pacing — BROKEN: classifier tags 88–98% of all stories
    'rapid', 'leisurely',
    # Mind control type — F1 < 0.30
    'possession',          # F1=0.288
    'body puppet',         # F1=0.289
    # Mental changes — F1 < 0.36 or dropped from AND-gate
    'induced love',        # F1=0.301
    'addiction / need',    # F1=0.304
    'corruption arc',      # F1=0.065 (dropped from AND-gate)
    'bimboization',        # F1=0.357 (classifier-only, no regex)
    'intelligence change', # F1=0.307 (classifier-only, no regex)
    # Awareness — dropped from AND-gate (F1 < 0.05)
    'denial',              # F1=0.323
    'oblivious',           # F1=0.043
    # Dominance — low precision, excluded from search filters too
    'brutal',              # F1=0.349, P=27%
    'gentle',              # F1=0.378, P=10%
    'cold / clinical',     # F1=0.048 (dropped from AND-gate)
    # Relationship — F1 < 0.41 or dropped from AND-gate
    'authority',           # F1=0.303
    'strangers',           # F1=0.405
    'reluctant subject',   # F1=0.052 (dropped from AND-gate)
    # Sexual acts — F1 < 0.30
    'creampie',            # F1=0.176 (dropped from AND-gate)
    'facial',              # F1=0.299 (scarce data)
    # Themes — dropped from AND-gate or classifier-only with low F1
    'horror / dark',       # F1=0.027 (dropped from AND-gate)
    'serial recruitment',  # F1=0.347 (classifier-only, no regex)
    'betrayal',            # F1=0.330 (classifier-only, no regex)
})

def _visible_tags(tags, at):
    """Return only tags that are reliable enough to display.

    A tag passes if:
    - It is NOT in LOW_QUALITY_SETFIT_TAGS, OR
    - It IS in the set but Svengali community data backs it
      (i.e. 'svengali' in auto_tags['_tag_sources'][tag]).
    """
    if not tags:
        return []
    sources = (at.get('_tag_sources') or {}) if isinstance(at, dict) else {}
    result = []
    for tag in tags:
        if tag not in LOW_QUALITY_SETFIT_TAGS:
            result.append(tag)
        elif 'svengali' in sources.get(tag, []):
            result.append(tag)
    return result

app.jinja_env.globals['visible_tags'] = _visible_tags

def stories():
    return _data.get("stories", [])

def valid_stories():
    # full_text is stripped from the slim in-memory index — use _has_text flag
    return [s for s in stories()
            if not s.get("fetch_error") and s.get("_has_text", s.get("full_text"))]

# ── Search & filter ───────────────────────────────────────────────────────────

def relevance_score(s: dict, q: str) -> float:
    """
    Score a story's relevance to a search query.
    Higher = more relevant. Used to rank results when sort=relevance.
    """
    if not q:
        return 0.0
    score    = 0.0
    q_lower  = q.lower()
    title    = (s.get("title") or "").lower()
    title_spaced = dt(s).lower()  # CamelCase slug → "Word Word Word"
    author   = (s.get("author") or "").lower()
    desc     = (s.get("description") or "").lower()
    cats     = " ".join(s.get("categories", [])).lower()
    at       = s.get("auto_tags") or {}
    themes   = " ".join(at.get("themes", [])).lower()
    mc       = " ".join(at.get("mind_control_type", [])).lower()
    full     = ""  # full_text not in slim index — scored via metadata only

    words = q_lower.split()

    def word_hits(field):
        """Count how many query words appear in field."""
        return sum(1 for w in words if w in field)

    all_words = len(words)

    # ── Title scoring ──────────────────────────────────────────────────────────
    # Exact phrase match in title = highest signal
    if q_lower == title or q_lower == title_spaced:
        score += 100
    elif title.startswith(q_lower) or title_spaced.startswith(q_lower):
        score += 60
    elif q_lower in title or q_lower in title_spaced:
        score += 40
    else:
        # Word-level: reward stories where more query words appear in the title
        hits = word_hits(title + " " + title_spaced)
        if hits == all_words: score += 30
        elif hits > 0:        score += hits * 8

    # ── Author match ───────────────────────────────────────────────────────────
    if q_lower == author:       score += 50
    elif q_lower in author:     score += 25
    elif word_hits(author) > 0: score += 10

    # ── Tag / category match ───────────────────────────────────────────────────
    if q_lower in cats:            score += 20
    elif word_hits(cats) == all_words: score += 12

    if q_lower in themes:          score += 15
    elif word_hits(themes) > 0:    score += 8

    if q_lower in mc:              score += 15
    elif word_hits(mc) > 0:        score += 8

    # ── Description match ──────────────────────────────────────────────────────
    if q_lower in desc:
        score += 10
    else:
        hits = word_hits(desc)
        if hits == all_words: score += 8
        elif hits > 0:        score += hits * 2

    return score


def _match_multi(selected, story_vals, logic="any"):
    """Check if story_vals satisfies the selected list under 'any' (OR) or 'all' (AND) logic."""
    if logic == "all":
        return all(any(sel.lower() in sv for sv in story_vals) for sel in selected)
    return any(any(sel.lower() in sv for sv in story_vals) for sel in selected)


def filter_score(s: dict, categories=None, mc_type="", setting="",
                 themes=None, theme_logic="all", tone="", dominance="", pacing="",
                 awareness="", length_class="",
                 sexual_acts=None, sexual_act_logic="any",
                 fetish_tags=None, fetish_tag_logic="any",
                 relationship="") -> float:
    """Return a score (0–1) for how well a story matches the given soft filters.
    Each active filter contributes equally; score = matched / total_active."""
    at = s.get("auto_tags") or {}
    checks = []
    if categories:
        story_cats = [c.lower() for c in s.get("categories", [])]
        checks.append(all(c.lower() in story_cats for c in categories))
    if mc_type:
        checks.append(any(mc_type.lower() in x.lower()
                          for x in at.get("mind_control_type", [])))
    if setting:
        checks.append(any(setting.lower() in x.lower()
                          for x in at.get("setting", [])))
    if themes:
        story_themes = [x.lower() for x in at.get("themes", [])]
        checks.append(_match_multi(themes, story_themes, theme_logic))
    if tone:
        checks.append(any(tone.lower() in x.lower() for x in at.get("tone", [])))
    if dominance:
        checks.append(any(dominance.lower() in x.lower()
                          for x in at.get("dominance", [])))
    if pacing:
        checks.append(any(pacing.lower() in x.lower() for x in at.get("pacing", [])))
    if awareness:
        checks.append(any(awareness.lower() in x.lower()
                          for x in at.get("awareness", [])))
    if length_class:
        checks.append(at.get("length_class", "").lower() == length_class.lower())
    if sexual_acts:
        story_acts = [x.lower() for x in at.get("sexual_acts", [])]
        checks.append(_match_multi(sexual_acts, story_acts, sexual_act_logic))
    if fetish_tags:
        story_fetish = [x.lower() for x in at.get("fetish", [])]
        checks.append(_match_multi(fetish_tags, story_fetish, fetish_tag_logic))
    if relationship:
        checks.append(any(relationship.lower() in x.lower()
                          for x in at.get("relationship", [])))
    if not checks:
        return 1.0
    return sum(checks) / len(checks)


_MONTH_MAP = {
    'january':1,'february':2,'march':3,'april':4,'may':5,'june':6,
    'july':7,'august':8,'september':9,'october':10,'november':11,'december':12,
}

def _parse_story_date(s):
    """Parse '15 January 2024' → (year, month) tuple, or None."""
    if not s:
        return None
    parts = s.strip().lower().split()
    if len(parts) == 3:
        try:
            return (int(parts[2]), _MONTH_MAP.get(parts[1], 0))
        except ValueError:
            pass
    return None


def _fts_candidate_ids(q: str, search_mode: str) -> frozenset:
    """
    Query stories_fts and return a frozenset of matching story IDs.
    Fast (~100ms) because it only scans the FTS index, not story metadata.
    Returns frozenset() on FTS error (bad query syntax).
    """
    if search_mode == "literal":
        fts_q = " AND ".join(f'"{w}"' for w in q.split())
    else:
        fts_q = " OR ".join(f'"{w}"' for w in q.split())
    try:
        rows = _search_conn.execute(
            "SELECT story_id FROM stories_fts WHERE stories_fts MATCH ?",
            (fts_q,)
        ).fetchall()
        return frozenset(row[0] for row in rows)
    except sqlite3.OperationalError:
        return frozenset()


def search_stories(query="", author="", categories=None, mc_type="",
                   setting="", themes=None, theme_logic="all", tone="", dominance="", pacing="",
                   awareness="", length_class="",
                   sexual_acts=None, sexual_act_logic="any",
                   fetish_tags=None, fetish_tag_logic="any",
                   relationship="",
                   min_words=0, date_from="", date_to="",
                   sort="relevance", page=1, per_page=30, soft=False,
                   archived=False, search_mode="fuzzy", liked_filter=False,
                   exclude_cats=None):
    # Hybrid path: FTS narrows candidates when query given, Python does all filtering.
    # No SQL for structured filters — Python loop is faster for 17k stories.
    fts_ids: frozenset | None = None
    q = query.lower().strip()
    if _search_conn and q:
        fts_ids = _fts_candidate_ids(q, search_mode)

    results = []
    word_coverage = {}  # story_id -> matched fraction (for closest-match sort)
    _themes_param = themes  # save; 'themes' name is reused below
    for s in valid_stories():
        if s.get("fetch_error"):
            continue
        at = s.get("auto_tags") or {}

        # ── Text search ────────────────────────────────────────────────────────
        if q:
            sid = s.get("id", "")
            if fts_ids is not None:
                # FTS available: use its result set (includes full-text matches)
                if sid not in fts_ids:
                    continue
                if search_mode == "fuzzy":
                    # Track coverage for ranking (rough — count title/desc word hits)
                    combined = " ".join([
                        (s.get("title") or "").lower(), dt(s).lower(),
                        (s.get("author") or "").lower(),
                        (s.get("description") or "").lower(),
                    ])
                    matched = sum(1 for w in q.split() if w in combined)
                    word_coverage[sid] = matched / len(q.split()) if q.split() else 0
            else:
                # FTS unavailable: fall back to metadata-only text match
                title        = (s.get("title") or "").lower()
                title_spaced = dt(s).lower()
                auth         = (s.get("author") or "").lower()
                desc         = (s.get("description") or "").lower()
                cats         = " ".join(s.get("categories", [])).lower()
                themes_str   = " ".join(at.get("themes", [])).lower()
                mc_t         = " ".join(at.get("mind_control_type", [])).lower()
                setting_t    = " ".join(at.get("setting", [])).lower()
                tone_t       = " ".join(at.get("tone", [])).lower()
                aware_t      = " ".join(at.get("awareness", [])).lower()
                combined = " ".join([title, title_spaced, auth, desc, cats,
                                     themes_str, mc_t, setting_t, tone_t, aware_t])
                words = q.split()
                if search_mode == "literal":
                    if not all(w in combined for w in words):
                        continue
                else:
                    matched = sum(1 for w in words if w in combined)
                    if matched == 0:
                        continue
                    word_coverage[s.get("id")] = matched / len(words)

        # ── Hard filters (author + min_words always absolute) ─────────────────
        if author and author.lower() not in (s.get("author") or "").lower():
            continue
        if min_words and s.get("word_count", 0) < min_words:
            continue
        if date_from or date_to:
            ym = _parse_story_date(s.get("added_date", ""))
            if ym:
                if date_from:
                    try:
                        y, m = int(date_from[:4]), int(date_from[5:7]) if len(date_from) > 4 else 1
                        if ym < (y, m):
                            continue
                    except ValueError:
                        pass
                if date_to:
                    try:
                        y, m = int(date_to[:4]), int(date_to[5:7]) if len(date_to) > 4 else 12
                        if ym > (y, m):
                            continue
                    except ValueError:
                        pass
        if archived and s.get("source") != "wayback":
            continue
        if liked_filter and _prefs:
            sid = s.get("id", "")
            author = s.get("author", "")
            if sid not in _prefs.liked_stories and author not in _prefs.liked_authors:
                continue

        if soft:
            # In soft mode all stories pass — filter_score used for ranking
            results.append(s)
        else:
            # ── Hard filters ──────────────────────────────────────────────────
            if categories:
                story_cats = [c.lower() for c in s.get("categories", [])]
                if not all(c.lower() in story_cats for c in categories):
                    continue
            if exclude_cats:
                story_cats_l = [c.lower() for c in s.get("categories", [])]
                if any(c.lower() in story_cats_l for c in exclude_cats):
                    continue
            if mc_type and not any(mc_type.lower() in x.lower()
                                   for x in at.get("mind_control_type", [])):
                continue
            if setting and not any(setting.lower() in x.lower()
                                   for x in at.get("setting", [])):
                continue
            if _themes_param:
                story_themes = [x.lower() for x in at.get("themes", [])]
                if not _match_multi(_themes_param, story_themes, theme_logic):
                    continue
            if tone and not any(tone.lower() in x.lower()
                                for x in at.get("tone", [])):
                continue
            if dominance and not any(dominance.lower() in x.lower()
                                     for x in at.get("dominance", [])):
                continue
            if pacing and not any(pacing.lower() in x.lower()
                                  for x in at.get("pacing", [])):
                continue
            if awareness and not any(awareness.lower() in x.lower()
                                     for x in at.get("awareness", [])):
                continue
            if length_class and at.get("length_class","").lower() != length_class.lower():
                continue
            if sexual_acts:
                story_acts = [x.lower() for x in at.get("sexual_acts", [])]
                if not _match_multi(sexual_acts, story_acts, sexual_act_logic):
                    continue
            if fetish_tags:
                story_fetish = [x.lower() for x in at.get("fetish", [])]
                if not _match_multi(fetish_tags, story_fetish, fetish_tag_logic):
                    continue
            if relationship and not any(relationship.lower() in x.lower()
                                        for x in at.get("relationship", [])):
                continue
            results.append(s)

    # ── Preference boost: rebuild cached tag profile when likes change ────────
    global _tag_profile_cache, _tag_profile_nlikes
    _pref_profile: dict = {}
    if _rec and _prefs and _prefs.liked_stories:
        n = len(_prefs.liked_stories)
        if n != _tag_profile_nlikes:
            _tag_profile_cache  = _rec._build_tag_profile(list(_prefs.liked_stories))
            _tag_profile_nlikes = n
        _pref_profile = _tag_profile_cache

    # ── Sort ──────────────────────────────────────────────────────────────────
    if soft and (q or any([categories, mc_type, setting, _themes_param,
                            tone, dominance, pacing, awareness, length_class,
                            sexual_acts, fetish_tags, relationship])):
        # Soft mode: rank by text relevance + filter match fraction
        def soft_score(s):
            rs = relevance_score(s, q) if q else 0.0
            fs = filter_score(s, categories=categories, mc_type=mc_type,
                              setting=setting, themes=_themes_param, theme_logic=theme_logic,
                              tone=tone, dominance=dominance, pacing=pacing,
                              awareness=awareness, length_class=length_class,
                              sexual_acts=sexual_acts, sexual_act_logic=sexual_act_logic,
                              fetish_tags=fetish_tags, fetish_tag_logic=fetish_tag_logic,
                              relationship=relationship)
            ps = pref_boost_score(s, _pref_profile) * 20 if _pref_profile else 0.0
            return rs + fs * 50 + ps  # pref boost ≈ up to 20 relevance pts
        results.sort(key=soft_score, reverse=True)
    elif sort == "relevance" or (sort == "relevance" and q):
        # Sort by relevance score when searching, else title
        if q and search_mode == "fuzzy":
            # Closest-match: primary key = word coverage fraction, secondary = relevance
            results.sort(key=lambda s: (word_coverage.get(s.get("id"), 0),
                                        relevance_score(s, q) +
                                        pref_boost_score(s, _pref_profile) * 20),
                         reverse=True)
        elif q:
            results.sort(key=lambda s: relevance_score(s, q) +
                                        pref_boost_score(s, _pref_profile) * 20,
                         reverse=True)
        else:
            results.sort(key=lambda s: s.get("added_date") or "", reverse=True)
    elif sort == "words_desc":
        results.sort(key=lambda s: s.get("word_count", 0), reverse=True)
    elif sort == "words_asc":
        results.sort(key=lambda s: s.get("word_count", 0))
    elif sort == "author":
        results.sort(key=lambda s: (s.get("author") or "").lower())
    elif sort == "date":
        results.sort(key=lambda s: s.get("added_date") or "", reverse=True)
    elif sort == "title":
        results.sort(key=lambda s: dt(s).lower())
    else:
        results.sort(key=lambda s: dt(s).lower())

    total = len(results)
    start = (page - 1) * per_page
    return results[start:start + per_page], total

def get_all_tags():
    """Return original mcstories category codes and auto_tag dimensions with counts."""
    cats = {}
    auto = {dim: {} for dim in
            ["mind_control_type", "setting", "themes", "tone",
             "dominance", "pacing", "awareness",
             "sexual_acts", "fetish", "relationship"]}
    for s in valid_stories():
        for c in s.get("categories", []):
            cats[c] = cats.get(c, 0) + 1
        at = s.get("auto_tags") or {}
        for dim in auto:
            for val in (at.get(dim) or []):
                auto[dim][val] = auto[dim].get(val, 0) + 1
    return (
        sorted(cats.items(), key=lambda x: -x[1]),
        {dim: sorted(v.items(), key=lambda x: -x[1])
         for dim, v in auto.items() if v}
    )

def get_all_authors():
    counts = {}
    for s in valid_stories():
        a = s.get("author") or "Unknown"
        counts[a] = counts.get(a, 0) + 1
    return sorted(counts.items(), key=lambda x: (-x[1], x[0]))

# ── HTML templates ────────────────────────────────────────────────────────────

BASE_HTML = '''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}MC Archive Browser{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
:root {
  --bg:      #f7f4f0;
  --bg2:     #eeeae4;
  --bg3:     #e4dfd7;
  --border:  #ccc7bf;
  --accent:  #8b4513;
  --accent2: #a0522d;
  --text:    #2c2418;
  --muted:   #7a6e62;
  --danger:  #8b2a2a;
  --radius:  6px;
  --liked:   #2a5a2a;
  --liked-bg:#e8f4e8;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: "Crimson Pro", Georgia, serif;
       font-size: 18px; line-height: 1.6; min-height: 100vh; }
a { color: var(--accent2); text-decoration: none; }
a:hover { color: var(--accent); text-decoration: underline; }
code, .mono { font-family: "JetBrains Mono", monospace; font-size: 0.78em; }

/* Layout */
.site-header { background: #3d2b1a; border-bottom: 1px solid #2a1d10;
               padding: 0.75rem 2rem; display: flex; align-items: center; gap: 2rem;
               position: sticky; top: 0; z-index: 100; }
.site-logo { font-size: 1.1rem; font-weight: 600; color: #e8c99a; letter-spacing: 0.05em;
             white-space: nowrap; }
.site-nav { display: flex; gap: 1.5rem; font-size: 0.9rem; flex-wrap: wrap; }
.site-nav a { color: #c8aa88; }
.site-nav a:hover { color: #fff; text-decoration: none; }

.search-bar { flex: 1; display: flex; gap: 0.5rem; }
.search-bar input { flex: 1; background: #2a1d10; border: 1px solid #5a3d22;
                    color: #e8c99a; padding: 0.4rem 0.8rem; border-radius: var(--radius);
                    font-family: inherit; font-size: 0.95rem; }
.search-bar input::placeholder { color: #8a6a4a; }
.search-bar input:focus { outline: none; border-color: #c8956a; }
.search-bar button { background: var(--accent2); color: #fff; border: none;
                     padding: 0.4rem 1rem; border-radius: var(--radius); cursor: pointer;
                     font-family: inherit; font-size: 0.9rem; }
.search-bar button:hover { background: var(--accent); }

.container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
.page-title { font-size: 1.8rem; font-weight: 300; color: var(--accent); margin-bottom: 1.5rem;
              border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }

/* Filters sidebar */
.layout { display: grid; grid-template-columns: 220px 1fr; gap: 2rem; }
.sidebar { font-size: 0.88rem; }
.filter-section { margin-bottom: 1.5rem; }
.filter-label { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.1em;
                text-transform: uppercase; margin-bottom: 0.5rem; display: block; }
.filter-section select, .filter-section input[type=text],
.filter-section input[type=number] {
  width: 100%; background: var(--bg3); border: 1px solid var(--border);
  color: var(--text); padding: 0.35rem 0.6rem; border-radius: var(--radius);
  font-family: inherit; font-size: 0.88rem; }
.filter-section select:focus, .filter-section input:focus {
  outline: none; border-color: var(--accent2); }
.filter-btn { width: 100%; background: var(--accent2); color: var(--text); border: none;
              padding: 0.5rem; border-radius: var(--radius); cursor: pointer;
              font-family: inherit; margin-top: 0.5rem; font-size: 0.9rem; }
.filter-btn:hover { background: var(--accent); }
.clear-btn { width: 100%; background: transparent; color: var(--muted); border: 1px solid var(--border);
             padding: 0.4rem; border-radius: var(--radius); cursor: pointer; font-family: inherit;
             font-size: 0.85rem; margin-top: 0.35rem; }
.clear-btn:hover { border-color: var(--muted); color: var(--text); }

/* Story cards */
.results-header { display: flex; justify-content: space-between; align-items: center;
                  margin-bottom: 1rem; font-size: 0.88rem; color: var(--muted); }
.story-grid { display: flex; flex-direction: column; gap: 0; }
.story-card { border-bottom: 1px solid var(--border); padding: 1rem 0;
              transition: background 0.15s; }
.story-card:hover { background: var(--bg2); margin: 0 -0.75rem; padding: 0.75rem 0.75rem 1rem; border-radius: var(--radius); border-bottom-color: transparent; }
.story-card.liked-card { border-left: 3px solid var(--liked); padding-left: 0.75rem; }
/* Preference highlighting tiers */
.pref-fave   { border-left: 4px solid #c8956a !important; padding-left: 0.75rem;
               background: linear-gradient(to right, #fdf6ee 0%, transparent 60%); }
.pref-author-fave { border-left: 4px solid #c8956a !important;
               background: linear-gradient(to right, #fdf0e4 0%, transparent 70%); }
.pref-author { border-left: 4px solid #8ab08a !important; padding-left: 0.75rem;
               background: linear-gradient(to right, #f2f7f2 0%, transparent 60%); }
.pref-liked  { border-left: 4px solid #6a8ab0 !important; padding-left: 0.75rem; }
.pref-badge  { display: inline-block; font-size: 0.68rem; padding: 0.1rem 0.4rem;
               border-radius: 3px; margin-left: 0.4rem; vertical-align: middle;
               font-family: "JetBrains Mono", monospace; letter-spacing: 0.02em; }
.badge-fave  { background: #c8956a; color: #fff; }
.badge-author{ background: #6a9a6a; color: #fff; }
.badge-liked { background: #4a7aaa; color: #fff; }
.story-title { font-size: 1.15rem; font-weight: 400; margin-bottom: 0.2rem; }
.story-meta { font-size: 0.82rem; color: var(--muted); display: flex; gap: 1rem;
              flex-wrap: wrap; margin-bottom: 0.4rem; }
.story-desc { font-size: 0.9rem; color: #a89880; font-style: italic;
              display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
              overflow: hidden; }
.tag { display: inline-block; background: #ede8e0; border: 1px solid var(--border);
       padding: 0.1rem 0.45rem; border-radius: 3px; font-size: 0.75rem; color: var(--muted);
       font-family: "JetBrains Mono", monospace; margin-right: 0.25rem; }
.tag:hover { border-color: var(--accent2); color: var(--text); text-decoration: none; }
.tag.mc-type { background: #f5ece4; border-color: var(--accent2); color: var(--accent); }
.chapters-badge { background: var(--bg3); border: 1px solid var(--border); padding: 0.1rem 0.4rem;
                  border-radius: 3px; font-size: 0.75rem; font-family: monospace; }

/* Story reader */
.reader-header { margin-bottom: 2rem; }
.reader-title { font-size: 2.2rem; font-weight: 300; color: var(--accent); line-height: 1.2; }
.reader-meta { margin-top: 0.75rem; color: var(--muted); font-size: 0.9rem; }
.reader-tags { margin-top: 0.75rem; }
.chapter-nav { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.chapter-btn { background: var(--bg3); border: 1px solid var(--border); color: var(--muted);
               padding: 0.3rem 0.8rem; border-radius: var(--radius); cursor: pointer;
               font-family: "JetBrains Mono", monospace; font-size: 0.8rem; }
.chapter-btn.active { background: var(--accent2); border-color: var(--accent); color: var(--text); }
.chapter-btn:hover { border-color: var(--accent2); }
.story-text { max-width: 960px; font-size: 1.15rem; line-height: 2.0;
              letter-spacing: 0.01em; }
.story-text p { margin-top: 0; margin-bottom: 1.2em; }
.story-text h3 + p, .story-text h3 + section { margin-top: 0.75em; }
.chapter-divider { text-align: center; color: var(--muted); margin: 2rem 0; letter-spacing: 0.3em; }

/* mcstories.com story formatting — adapted for dark theme */
.story-text blockquote { margin-left:1.25em; margin-right:2em;
    border-left:3px solid var(--border); padding-left:0.75em; }
.story-text .textMessage { font-family:Verdana,"Lucida Sans Unicode","Lucida Grande",sans-serif;
    font-style:normal; font-size:85%; }
.story-text em em { font-style:normal; }
.story-text em em em { font-style:italic; }
.story-text .overstrike { text-decoration:line-through; }
.story-text .signed, .story-text .inlineDate, .story-text .caption { font-style:italic; }
.story-text .stage { font-style:italic; }
.story-text pre, .story-text kbd, .story-text .typewriter {
    font-family:"Courier New",Courier,monospace; font-size:85%;
    white-space:pre-wrap; }
.story-text .milestone { display:block; text-align:center; font-size:130%;
    letter-spacing:1em; margin:1em 0; }
.story-text h3.email { font-size:110%; }
.story-text .epigraph { margin:1em 0; }
.story-text .epigraph .bibl { text-align:right; margin-right:4em; }
.story-text .lg, .story-text .sp { margin:1em 0; }
.story-text div.indented { margin-left:2em; }
.story-text .screenplay { font-family:"Courier New",Courier,monospace;
    text-indent:0; margin-left:1em; }
.story-text .screenplay dt { display:block; text-align:center; }
.story-text .screenplay .caption { text-align:center; }
.story-text .screenplay p { text-indent:0; }
.story-text section + section { margin-top:2em; }
.story-text hr { border:none; border-top:1px solid var(--border); margin:1.5em auto;
    width:30%; }

/* Pagination */
.pagination { display: flex; gap: 0.5rem; justify-content: center; margin-top: 2rem; }
.pagination a, .pagination span { padding: 0.4rem 0.8rem; border: 1px solid var(--border);
  border-radius: var(--radius); font-size: 0.88rem; }
.pagination a:hover { border-color: var(--accent2); text-decoration: none; }
.pagination .current { background: var(--accent2); border-color: var(--accent); color: var(--text); }

/* Stats */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
.stat-card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);
             padding: 1.25rem; text-align: center; }
.stat-value { font-size: 2rem; font-weight: 300; color: var(--accent); display: block; }
.stat-label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase;
              letter-spacing: 0.08em; margin-top: 0.25rem; }
.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
.tag-cloud-item { background: var(--bg2); border: 1px solid var(--border);
                  padding: 0.25rem 0.6rem; border-radius: 3px; font-size: 0.82rem; }
.tag-cloud-item:hover { border-color: var(--accent2); text-decoration: none; }

/* Error */
.error-box { background: #1a0e0e; border: 1px solid var(--danger); border-radius: var(--radius);
             padding: 1.5rem; margin: 2rem 0; }
/* Story preview */
.preview-box { display:none; margin-top:0.6rem; padding:0.6rem 0.8rem;
               background:var(--bg); border:1px solid var(--border); border-radius:4px;
               font-size:0.86rem; line-height:1.6; color:#c8b8a8; max-height:200px;
               overflow-y:auto; white-space:pre-wrap; }
.preview-box.open { display:block; }
.preview-btn { background:none; border:1px solid var(--border); color:var(--muted);
               padding:0.12rem 0.5rem; border-radius:3px; cursor:pointer;
               font-size:0.75rem; font-family:inherit; margin-left:0.3rem; }
.preview-btn:hover { border-color:var(--accent2); color:var(--text); }
mark.hl { background:#5a4a20; color:#f0d890; border-radius:2px; padding:0 2px; }
/* History badge */
.badge-history { background:#1e2e3a; color:#6aaccc; border:1px solid #3a5a7a; }
.badge-wtr     { background:#1e3a2a; color:#6acc88; border:1px solid #3a7a4a; }
/* Tag tooltips */
.tag { position: relative; }
.tag-tip { display: none; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);
           background: #2a2520; border: 1px solid var(--accent2); color: var(--text);
           padding: 0.3rem 0.6rem; border-radius: 4px; white-space: nowrap; font-size: 0.78rem;
           font-family: "Crimson Pro", serif; z-index: 200; pointer-events: none; }
.tag:hover .tag-tip { display: block; }
</style>
</head>
<body>
<header class="site-header">
  <a class="site-logo" href="/" style="text-decoration:none;">⊕ MC Archive</a>
  <form class="search-bar" action="/search" method="get" id="search-bar-form">
    <input type="text" name="q" placeholder="Search titles, authors, tags, descriptions…"
           value="{{ request.args.get('q', '') }}">
    <button type="submit">Search</button>
  </form>
  <script>
  /* Preserve active filters when the top search bar is submitted.
     Copies all current URL params (except 'q' and 'page') into the form
     as hidden fields so filters survive a search text change. */
  document.getElementById('search-bar-form').addEventListener('submit', function() {
    var form = this;
    var params = new URLSearchParams(window.location.search);
    params.forEach(function(val, key) {
      if (key === 'q' || key === 'page') return;
      var h = document.createElement('input');
      h.type = 'hidden'; h.name = key; h.value = val;
      form.appendChild(h);
    });
  });
  </script>
  <nav class="site-nav">
    <a href="/">Browse</a>
    <a href="/recommendations">&#9829; For You</a>
    <a href="/liked">&#9733; Liked</a>
    <a href="/history">&#9654; History</a>
    <a href="/want-to-read">&#128278; Want to read</a>
    <a href="/new-stories">&#9679; New</a>
    <a href="/authors">Authors</a>
    <a href="/tags">Tags</a>
    <a href="/random">Random</a>
    <a href="/generate">&#9998; Generate</a>
  </nav>
</header>
<div class="container">
{% block content %}{% endblock %}
</div>
<script>
