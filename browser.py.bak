@app.route("/random")
def random_story():
    pool = valid_stories()
    if not pool:
        abort(404)
    s = random.choice(pool)
    return redirect(f"/story/{s['id']}")

@app.route("/stats")
def stats():
    vs = valid_stories()
    total_words = sum(s.get("word_count", 0) for s in vs)
    tag_counts = {}
    for s in vs:
        for c in s.get("categories", []):
            tag_counts[c] = tag_counts.get(c, 0) + 1
    top_tags = sorted(tag_counts.items(), key=lambda x: -x[1])[:30]
    stats_data = {
        "total":        len(vs),
        "authors":      len(set(s.get("author") for s in vs)),
        "avg_words":    total_words / max(len(vs), 1),
        "total_words_m": round(total_words / 1_000_000, 1),
        "multi_chapter": sum(1 for s in vs if s.get("chapter_count", 1) > 1),
        "errors":       sum(1 for s in stories() if s.get("fetch_error")),
        "top_tags":     top_tags,
    }
    tmpl = app.jinja_env.from_string(STATS_TMPL)
    return tmpl.render(stats=stats_data, request=request)

@app.route("/api/search")
def api_search():
    """JSON API for search — useful for LLM integrations."""
    q       = request.args.get("q", "")
    limit   = min(int(request.args.get("limit", 20)), 100)
    results, total = search_stories(query=q, per_page=limit)
    return jsonify({
        "total": total,
        "stories": [{
            "id":          s["id"],
            "title":       s.get("title"),
            "author":      s.get("author"),
            "word_count":  s.get("word_count"),
            "categories":  s.get("categories"),
            "description": s.get("description"),
            "auto_tags":   s.get("auto_tags"),
        } for s in results]
    })

