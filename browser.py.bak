@app.route("/api/generate/retrieve", methods=["POST"])
def api_generate_retrieve():
    """RAG: find similar stories to use as generation examples."""
    data  = request.get_json(force=True)
    query = data.get("query", "")
    tags  = data.get("tags", {})

    # Build a richer search query from tags + text
    full_query = " ".join(filter(None, [
        query,
        tags.get("mc_type", ""),
        tags.get("setting", ""),
        tags.get("tone", ""),
        " ".join(tags.get("themes", [])),
    ]))

    # Use recommendation engine if available (semantic), else text search
    examples = []
    if _rec and _engine._loaded and full_query.strip():
        from recommender import EmbeddingEngine
        # Encode the query as if it were a story signature
        if _engine.semantic:
            import numpy as np
            qvec = _engine._model.encode([full_query], normalize_embeddings=True)[0]
            scores = []
            for sid, s in _rec.stories.items():
                sv = _engine._embeddings.get(sid)
                if sv is None:
                    continue
                score = float(np.dot(sv, qvec))
                scores.append((s, score))
            scores.sort(key=lambda x: -x[1])
            examples = [{"id": s["id"], "title": s.get("title", ""),
                         "author": s.get("author", ""),
                         "score": round(sc, 3),
                         "categories": s.get("categories", []),
                         "auto_tags": s.get("auto_tags"),
                         "description": s.get("description", ""),
                         "full_text": s.get("full_text", ""),
                         "word_count": s.get("word_count", 0)}
                        for s, sc in scores[:5]]
        else:
            # Tag-overlap fallback
            results, _ = search_stories(query=query,
                mc_type=tags.get("mc_type",""),
                setting=tags.get("setting",""),
                tone=tags.get("tone",""),
                per_page=5)
            examples = [{"id": s["id"], "title": s.get("title",""),
                         "author": s.get("author",""), "score": 0.5,
                         "categories": s.get("categories",[]),
                         "auto_tags": s.get("auto_tags"),
                         "description": s.get("description",""),
                         "full_text": s.get("full_text",""),
                         "word_count": s.get("word_count",0)}
                        for s in results[:5]]
    elif full_query.strip():
        results, _ = search_stories(query=query, per_page=5)
        examples = [{"id": s["id"], "title": s.get("title",""),
                     "author": s.get("author",""), "score": 0.5,
                     "categories": s.get("categories",[]),
                     "auto_tags": s.get("auto_tags"),
                     "description": s.get("description",""),
                     "full_text": s.get("full_text",""),
                     "word_count": s.get("word_count",0)}
                    for s in results[:5]]

    # Don't send full_text back to browser — just metadata for display
    display_examples = [{"id": e["id"], "title": e["title"],
                          "author": e["author"], "score": e["score"]}
                         for e in examples]
    return jsonify({"examples": display_examples})


@app.route("/api/generate/stream", methods=["POST"])
def api_generate_stream():
    """Stream story generation from local LLM."""
    from generator import LLMClient, build_prompt, estimate_tokens
    from flask import Response, stream_with_context

    data         = request.get_json(force=True)
    request_text = data.get("request_text", "")
    example_ids  = [e["id"] for e in data.get("examples", [])]
    tags         = data.get("tags", {})
    mode         = data.get("mode", "inspired")
    url          = data.get("url", "http://localhost:1234/v1")
    key          = data.get("key", "none")
    model_name   = data.get("model", "auto")
    temperature  = float(data.get("temperature", 0.85))
    max_tokens   = int(data.get("max_tokens", 3000))

    # Fetch full story data for examples
    examples = []
    for eid in example_ids:
        s = _data.get("by_id", {}).get(eid)
        if s:
            examples.append(s)
    # If no examples found by ID, do a quick text search
    if not examples and request_text:
        results, _ = search_stories(query=request_text, per_page=3)
        examples = results

    length_class = tags.get("length", "short story")
    max_tokens   = estimate_tokens(length_class)

    client   = LLMClient(base_url=url, api_key=key, model=model_name)
    messages = build_prompt(request_text, examples, tags, style_mode=mode)

    def generate_stream():
        try:
            for chunk in client.complete(messages, max_tokens=max_tokens,
                                         temperature=temperature, stream=True):
                yield chunk
        except Exception as e:
            yield f"\n\n[Error: {e}]"

    if not client.ping():
        return jsonify({"error":
            "Cannot connect to LLM. Make sure LM Studio or Ollama is running."}), 503

    return Response(stream_with_context(generate_stream()),
                    mimetype="text/plain",
                    headers={"X-Accel-Buffering": "no",
                             "Cache-Control": "no-cache"})


