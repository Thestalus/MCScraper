@app.route("/generate")
def generate_page():
    from tagger import (SETTING_RULES, THEME_RULES, TONE_RULES,
                        MIND_CONTROL_TYPE_RULES, DOMINANCE_RULES, PACING_RULES)
    mc_types   = [r[0] for r in MIND_CONTROL_TYPE_RULES]
