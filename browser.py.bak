@app.route("/liked")
def liked():
    if not _prefs:
        abort(503)
    liked_ids    = _prefs.liked_stories
    liked_stories = [_data["by_id"][sid] for sid in liked_ids
                     if sid in _data.get("by_id", {})]
    liked_authors = _prefs.liked_authors
    tmpl = app.jinja_env.from_string(LIKED_TMPL)
    return tmpl.render(liked_stories=liked_stories, liked_authors=liked_authors,
                       request=request)


@app.route("/liked/export")
def liked_export():
    if not _prefs:
        abort(503)
    fmt  = request.args.get("fmt", "json")
    ids  = _prefs.liked_stories
    stories = [_data["by_id"][sid] for sid in ids if sid in _data.get("by_id", {})]

    if fmt == "csv":
        import csv, io
        buf = io.StringIO()
        w   = csv.writer(buf)
        w.writerow(["id","title","author","word_count","categories","story_url"])
        for s in stories:
            w.writerow([s["id"], s.get("title",""), s.get("author",""),
                        s.get("word_count",0),
                        " ".join(s.get("categories",[])),
                        s.get("story_url","")])
        from flask import Response
        return Response(buf.getvalue(), mimetype="text/csv",
                        headers={"Content-Disposition":"attachment;filename=liked_stories.csv"})
    elif fmt == "txt":
        lines = [f"{s.get('title') or s['id']} — {s.get('author','')}" for s in stories]
        from flask import Response
        return Response("\n".join(lines), mimetype="text/plain",
                        headers={"Content-Disposition":"attachment;filename=liked_stories.txt"})
    else:
        export = [{"id":s["id"],"title":s.get("title"),"author":s.get("author"),
                   "word_count":s.get("word_count"),"categories":s.get("categories"),
                   "story_url":s.get("story_url")} for s in stories]
        from flask import Response
        return Response(json.dumps(export, indent=2, ensure_ascii=False),
                        mimetype="application/json",
                        headers={"Content-Disposition":"attachment;filename=liked_stories.json"})


@app.route("/new-stories")
def new_stories():
    """
    Show stories added in the most recent update run.
    Uses update_log.json if present (written by update.py),
    otherwise falls back to the last N stories in the index.
    """
    update_log_path = Path(OUTPUT_DIR) / "update_log.json"
    runs       = []
    new        = []
    last_added = 0

    if update_log_path.exists():
        try:
            with open(update_log_path) as f:
                log_data = json.load(f)
            runs = log_data.get("runs", [])
        except:
            pass

    all_valid = [s for s in stories()
                 if not s.get("fetch_error") and s.get("_has_text", True)]
    by_id = _data.get("by_id", {})

    new             = []   # (story, badge) tuples — badge is None or "New chapter"
    chapter_updated = []

    if runs:
        last = runs[-1]
        new_ids = last.get("new_story_ids") or []
        ch_ids  = last.get("chapter_updated_ids") or []

        if new_ids or ch_ids:
            new_id_set = set(new_ids)
            ch_id_set  = set(ch_ids)
            new_stories_list    = []
            chapter_update_list = []
            for s in all_valid:
                if s["id"] in new_id_set:
                    new_stories_list.append((s, None))
                elif s["id"] in ch_id_set:
                    chapter_update_list.append((s, "New chapter"))
            new = new_stories_list + chapter_update_list
        else:
            # Old log entries without ID lists — fall back to count
            last_added = last.get("stories_added_to_index", 0)
            if last_added > 0:
                new = [(s, None) for s in all_valid[-last_added:]]

    if not new:
        # Fallback: use last_seen_count from preferences
        last_seen = _prefs.data.get("last_seen_count", 0) if _prefs else 0
        new = [(s, None) for s in (all_valid[last_seen:] if last_seen < len(all_valid) else [])]
        if _prefs and new:
            _prefs.data["last_seen_count"] = len(all_valid)
            _prefs._save()

    scrape_date = _data.get("last_updated", _data.get("scraped_at", ""))[:10] if _data else ""
    last_run    = runs[-1]["timestamp"][:10] if runs else ""

    tmpl = app.jinja_env.from_string(NEW_STORIES_TMPL)
    return tmpl.render(new_stories=new, scrape_date=scrape_date,
                       last_run=last_run, update_runs=runs[-8:],
                       prefs=_prefs, request=request)


# ── Recommendation routes ─────────────────────────────────────────────────────

@app.route("/api/like/<story_id>", methods=["POST"])
def api_like(story_id):
    if not _prefs:
        return jsonify({"ok": False, "error": "preferences not loaded"})
    data   = request.get_json(force=True)
    status = data.get("status", "liked")
    if status == "liked":
        _prefs.like_story(story_id)
    elif status == "disliked":
        _prefs.dislike_story(story_id)
    else:
        _prefs.unlike_story(story_id)
    return jsonify({"ok": True, "status": status})


@app.route("/api/like-author/<path:author_name>", methods=["POST"])
def api_like_author(author_name):
    if not _prefs:
        return jsonify({"ok": False})
    data   = request.get_json(force=True)
    status = data.get("status", "liked")
    if status == "liked":
        _prefs.like_author(author_name)
    elif status == "disliked":
        _prefs.dislike_author(author_name)
    else:
        _prefs.unlike_author(author_name)
    return jsonify({"ok": True, "status": status})


@app.route("/api/dismiss-rec/<story_id>", methods=["POST"])
def api_dismiss_rec(story_id):
    if not _prefs:
        return jsonify({"ok": False})
    _prefs.hide_rec(story_id)
    return jsonify({"ok": True})


@app.route("/api/restore-dismissed", methods=["POST"])
def api_restore_dismissed():
    if not _prefs:
        return jsonify({"ok": False})
    _prefs.data["hidden_recs"] = []
    _prefs._save()
    return jsonify({"ok": True})


@app.route("/api/want/<story_id>", methods=["POST"])
def api_want(story_id):
    if not _prefs:
        return jsonify({"ok": False})
    data   = request.get_json(force=True)
    wanted = bool(data.get("wanted", True))
    if wanted:
        _prefs.want_story(story_id)
    else:
        _prefs.unwant_story(story_id)
    return jsonify({"ok": True, "wanted": wanted})


@app.route("/api/preview/<story_id>")
def api_preview(story_id):
    s = _data.get("by_id", {}).get(story_id)
    if not s:
        return jsonify({"text": ""})
    full_text = s.get("full_text") or get_story_text(story_id)
    # Strip HTML tags for plain-text preview display
    import re as _re
    plain = _re.sub(r"<[^>]+>", " ", full_text) if "<" in full_text else full_text
    plain = _re.sub(r"\s+", " ", plain).strip()
    preview = plain[:700].rsplit(None, 1)[0] if len(plain) > 700 else plain
    return jsonify({"text": preview + ("…" if len(plain) > 700 else "")})


@app.route("/api/history/<story_id>", methods=["POST"])
def api_history(story_id):
    if not _prefs:
        return jsonify({"ok": False})
    data    = request.get_json(force=True)
    chapter = int(data.get("chapter", 1))
    total   = int(data.get("total", 1))
    _prefs.record_visit(story_id, chapter, total)
    return jsonify({"ok": True})


